<UserControl x:Class="Brisk.Views.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <UserControl.Resources>
        <Brisk:LocKeyConverter x:Key="LocKey" />
    </UserControl.Resources>
    <DockPanel Margin="18,16">
        <!-- Every docked band and the scroll content share the app's one
             content column (see ContentMaxWidth in Shared.xaml). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                MaxWidth="{StaticResource ContentMaxWidth}"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,10"
                Visibility="{Binding HasBanner,
                    Converter={x:Static Brisk:BoolToVis.Instance}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                           Text="{Binding BannerText}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Margin="0,0,6,0" Command="{Binding UndoCommand}"
                            Content="{Binding [clean.undo], Source={x:Static loc:Loc.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <!-- Restore mutates the bin too, so it waits
                                         its turn behind any clean in flight. -->
                                    <DataTrigger Binding="{Binding State.IsCleaning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,6,0" Command="{Binding ReclaimCommand}"
                            Content="{Binding [clean.reclaim], Source={x:Static loc:Loc.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <!-- Same: this purges, so it never runs
                                         alongside another surface's purge. -->
                                    <DataTrigger Binding="{Binding State.IsCleaning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                            Margin="0,0,10,0" Command="{Binding OpenBinCommand}"
                            Visibility="{Binding RestoreFailed,
                                Converter={x:Static Brisk:BoolToVis.Instance}}"
                            Content="↗" />
                    <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                            Command="{Binding DismissCommand}"
                            Content="{Binding [clean.dismiss], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                   MaxWidth="{StaticResource ContentMaxWidth}"
                   TextWrapping="Wrap" Text="{Binding ProblemsText}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <!-- Round 11 page hero: the storage story as instruments —
                     THE reclaimable number lives here now (it counts down
                     live through the engine's per-entry stream during a
                     clean), with free space and the lifetime figure as
                     pods. One number on the page, worn as status. -->
                <Border Style="{StaticResource HeroStrip}" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- NumeralTick: data-driven motion, exempt from
                                 reduce-motion gating by design. -->
                            <TextBlock Style="{StaticResource HeroScore}" FontSize="40"
                                       Foreground="{StaticResource HeroText}"
                                       Brisk:NumeralTick.Value="{Binding SimpleTotalText}" />
                            <TextBlock Style="{StaticResource HeroStripCaption}"
                                       Margin="2,2,0,0"
                                       Text="{Binding [clean.hero.reclaimable],
                                           Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroPod}" Margin="0,0,10,0">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="2"
                                               RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                               Fill="{StaticResource HeroAccent}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeroPodValue}"
                                                   Brisk:NumeralTick.Value="{Binding FreeDiskText}" />
                                        <TextBlock Style="{StaticResource HeroPodCaption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding [overview.live.disk],
                                                       Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource HeroPod}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="2"
                                               RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                               Fill="{StaticResource HeroAccent}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeroPodValue}"
                                                   Brisk:NumeralTick.Value="{Binding LifetimeValueText}" />
                                        <TextBlock Style="{StaticResource HeroPodCaption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding [clean.hero.lifetime],
                                                       Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- The simple face (round 9): the groups, one Temizle. The
                     big number moved up into the hero (round 11) — one
                     number on the page, no duplicated promise. This is the
                     whole page for a non-technical user; the technical
                     three-level list waits behind "Gelişmiş" below.
                     Presentation only — the button runs exactly today's
                     safe-level defaults (CleanService.CleanSafe). -->
                <Border Background="{DynamicResource BgElevated}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Padding="20,8"
                                    FontSize="12.5" VerticalAlignment="Center"
                                    Command="{Binding SimpleCleanCommand}">
                                <!-- Content lives in the STYLE (a local value
                                     would beat the busy trigger). -->
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content"
                                                Value="{Binding [clean.clean],
                                                    Source={x:Static loc:Loc.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.IsScanning}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <!-- Round-13 re-review (N1): one
                                                 runner behind every clean
                                                 button, so ANY clean in
                                                 flight — this card's, the
                                                 overview's, the tray's —
                                                 refuses the lease. The
                                                 button says so instead of
                                                 going dead under the press. -->
                                            <DataTrigger Binding="{Binding State.IsCleaning}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <!-- IsSimpleCleanBusy, not IsBusy:
                                                 a Gelişmiş level clean also
                                                 raises IsBusy, and THIS
                                                 button isn't the one working
                                                 then. -->
                                            <DataTrigger Binding="{Binding IsSimpleCleanBusy}"
                                                         Value="True">
                                                <Setter Property="Content"
                                                        Value="{Binding [clean.cleaning],
                                                            Source={x:Static loc:Loc.Instance}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding [clean.simple.title],
                                           Source={x:Static loc:Loc.Instance}}" />
                        </DockPanel>
                        <!-- Work in flight: a determinate hairline fed by the
                             engine's own entry stream, and the honest count
                             beside it. Visible only while THE SIMPLE clean
                             runs — a level clean must not light this card
                             up with stale progress. -->
                        <DockPanel Margin="0,0,0,10"
                                   Visibility="{Binding IsSimpleCleanBusy,
                                       Converter={x:Static Brisk:BoolToVis.Instance}}">
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0"
                                       Style="{StaticResource Faint}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProgressText}" />
                            <ProgressBar Style="{StaticResource ThinProgress}"
                                         Minimum="0" Maximum="1"
                                         VerticalAlignment="Center"
                                         Value="{Binding ProgressFraction, Mode=OneWay}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SimpleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding SizeText}" />
                                        <TextBlock Style="{StaticResource Muted}"
                                                   Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The honest second half (round 11): bytes the
                             number above deliberately does NOT contain,
                             each with its actionable why — "+310 MB when
                             you close WhatsApp". Quiet, informative, never
                             an alarm. -->
                        <ItemsControl Margin="0,4,0,0"
                                      ItemsSource="{Binding LockedNotes}"
                                      Visibility="{Binding HasLockedNotes,
                                          Converter={x:Static Brisk:BoolToVis.Instance}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Faint}"
                                               Margin="0,2" TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The completion report: what went, what the disk
                             says, and calmly why anything was left alone —
                             the same left-rule vocabulary the findings
                             report speaks, worn quietly inside the card. -->
                        <DockPanel Margin="0,12,0,0"
                                   Visibility="{Binding HasReport,
                                       Converter={x:Static Brisk:BoolToVis.Instance}}">
                            <Rectangle DockPanel.Dock="Left" Width="2"
                                       RadiusX="1" RadiusY="1" Margin="0,2"
                                       Fill="{DynamicResource Good}" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource ReportLine}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{Binding ReportSummary}" />
                                <!-- No more "571.3 GB → 571.3 GB": the line
                                     says where the bytes ARE (bin / freed),
                                     and disappears when there is nothing
                                     truthful to say. -->
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="{Binding ReportDiskText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReportDiskText}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- No action row (round 12, owner
                                     directive): the simple clean purges
                                     its own recycled items automatically —
                                     the space is simply free; nothing to
                                     press, nothing to undo. The banner
                                     above keeps Undo/Reclaim for the
                                     Gelişmiş level cleans. -->
                                <TextBlock Style="{StaticResource Faint}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="{Binding ReportReasonsText}"
                                           Visibility="{Binding HasReportReasons,
                                               Converter={x:Static Brisk:BoolToVis.Instance}}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding [clean.simple.hint],
                                       Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- Power users: the full technical list, exactly as before,
                     behind one quiet fold. -->
                <!-- Round 11: the Win11 focus ring instead of the classic
                     dotted marching-ants rectangle the owner saw after
                     clicking; keyboard focus keeps its visual. -->
                <ToggleButton IsChecked="{Binding IsAdvancedShown}" Cursor="Hand"
                              FocusVisualStyle="{StaticResource Win11FocusVisual}"
                              HorizontalAlignment="Left" Margin="2,14,0,8">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal"
                                        Background="Transparent">
                                <Path x:Name="Chevron" Data="M 0 0 L 4.5 4.5 L 9 0"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource TextMuted}"
                                      VerticalAlignment="Center" Margin="0,1,8,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{Binding [clean.advanced],
                                               Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron"
                                            Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ItemsControl ItemsSource="{Binding Levels}"
                              Visibility="{Binding IsAdvancedShown,
                                  Converter={x:Static Brisk:BoolToVis.Instance}}">
                    <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgElevated}"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,0,0,8" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                               Text="{Binding TitleKey,
                                                   Converter={StaticResource LocKey}}" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="{Binding TotalText}" />
                                        <Button Command="{Binding CleanCommand}"
                                                Content="{Binding [clean.clean],
                                                    Source={x:Static loc:Loc.Instance}}">
                                            <!-- The section is the DataContext
                                                 here, so the shared signal
                                                 comes off the page's. -->
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                            Binding="{Binding DataContext.State.IsCleaning,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2">
                                                <DockPanel>
                                                    <CheckBox Style="{StaticResource QuietCheck}"
                                                              IsChecked="{Binding IsSelected}"
                                                              IsEnabled="{Binding IsSelectable}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource Body}"
                                                               Margin="8,0,0,0"
                                                               Text="{Binding DisplayName}" />
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Style="{StaticResource Faint}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Text="{Binding SkippedText}" />
                                                        <TextBlock Style="{StaticResource Faint}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Visibility="{Binding NeedsElevation,
                                                                       Converter={x:Static Brisk:BoolToVis.Instance}}"
                                                                   Text="{Binding [clean.elevation],
                                                                       Source={x:Static loc:Loc.Instance}}" />
                                                        <TextBlock Style="{StaticResource Muted}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding SizeText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              Margin="24,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1">
                                                                <CheckBox Style="{StaticResource QuietCheck}"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Center" />
                                                                <TextBlock Style="{StaticResource Faint}"
                                                                           Margin="8,0,0,0"
                                                                           Text="{Binding PathText}" />
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource Faint}"
                                                                           Text="{Binding SizeText}" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
