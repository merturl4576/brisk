<UserControl x:Class="Brisk.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <DockPanel Margin="18,16">
        <!-- Every docked band and the scroll content share the app's one
             content column (see ContentMaxWidth in Shared.xaml). -->
        <!-- Round 11 page hero: the domain's state leads the page — the
             health score on its own instrument ring, on the same always-
             dark panel the overview cockpit wears, one size lighter. No
             ambient clocks here: the gauge sweep and the numeral are
             data-driven and only move when a scan speaks. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource HeroStrip}"
                MaxWidth="{StaticResource ContentMaxWidth}" Margin="0,0,0,10">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="132" Height="132">
                    <Brisk:SegmentedGauge Width="132" Height="132" Layer="Unlit"
                                          UnlitBrush="{StaticResource HeroUnlit}"
                                          Score="{Binding ScoreValue}" />
                    <Brisk:SegmentedGauge Width="132" Height="132" Layer="Lit"
                                          Score="{Binding ScoreValue}">
                        <Brisk:SegmentedGauge.Style>
                            <Style TargetType="{x:Type Brisk:SegmentedGauge}">
                                <Setter Property="LitBrush"
                                        Value="{StaticResource HeroGood}" />
                                <Setter Property="GlowColor"
                                        Value="{StaticResource HeroGoodColor}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                 Value="SeverityWarning">
                                        <Setter Property="LitBrush"
                                                Value="{StaticResource HeroWarn}" />
                                        <Setter Property="GlowColor"
                                                Value="{StaticResource HeroWarnColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                 Value="SeverityCritical">
                                        <Setter Property="LitBrush"
                                                Value="{StaticResource HeroCrit}" />
                                        <Setter Property="GlowColor"
                                                Value="{StaticResource HeroCritColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Brisk:SegmentedGauge.Style>
                    </Brisk:SegmentedGauge>
                    <TextBlock Style="{StaticResource HeroScore}" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Brisk:NumeralTick.Value="{Binding ScoreText}" />
                </Grid>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeroStripCaption}"
                               Text="{Binding [health.title], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="14" Foreground="{StaticResource HeroText}"
                               Text="{Binding StatusLine}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- No HorizontalAlignment here: the one content column works by
             MaxWidth + default Stretch (a width-capped Stretch element is
             arranged centered) — an explicit Left pins the band to the
             window edge, outside the column (the round-11 live regression). -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"
                    MaxWidth="{StaticResource ContentMaxWidth}">
            <Button Margin="0,0,8,0" Command="{Binding ScanCommand}"
                    Content="{Binding [flyout.scan], Source={x:Static loc:Loc.Instance}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="0,0,16,0" Command="{Binding FixAllCommand}"
                    Content="{Binding [health.fixall], Source={x:Static loc:Loc.Instance}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <CheckBox Style="{StaticResource QuietCheck}" VerticalAlignment="Center"
                      IsChecked="{Binding CreateRestorePointFirst}"
                      Content="{Binding [health.restorepoint], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                    MaxWidth="{StaticResource ContentMaxWidth}"
                    Visibility="{Binding State.IsScanning,
                        Converter={x:Static Brisk:BoolToVis.Instance}}">
            <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                         Background="{DynamicResource Divider}"
                         Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}"
                           Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                           Text="{Binding State.ProgressText}" />
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   MaxWidth="{StaticResource ContentMaxWidth}"
                   Text="{Binding Message}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Emphasized completion report after a fix run on this page. -->
        <ContentControl DockPanel.Dock="Top" Focusable="False" Content="{Binding}"
                        MaxWidth="{StaticResource ContentMaxWidth}"
                        ContentTemplate="{StaticResource CompletionReport}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <TextBlock Margin="0,10,0,6"
                           Text="{Binding [health.advise.section], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AdviseRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding AdviseRows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <!-- Where the rest of the findings live (category split):
                     a quiet link to the Performans page. -->
                <Button Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="2,10,0,0"
                        Foreground="{DynamicResource TextMuted}"
                        Command="{Binding CrossNavigateCommand}"
                        Content="{Binding CrossLinkText}"
                        Visibility="{Binding HasCrossLink,
                            Converter={x:Static Brisk:BoolToVis.Instance}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
