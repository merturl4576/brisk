<UserControl x:Class="Brisk.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <DockPanel Margin="18,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionLabel}" Margin="0"
                           Text="{Binding [health.title], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Style="{StaticResource ScoreText}" FontSize="30"
                           Margin="0,2,0,0" Text="{Binding ScoreText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <CheckBox Style="{StaticResource QuietCheck}" Margin="0,0,16,0"
                          IsChecked="{Binding CreateRestorePointFirst}"
                          Content="{Binding [health.restorepoint], Source={x:Static loc:Loc.Instance}}" />
                <Button Margin="0,0,8,0" Command="{Binding ScanCommand}"
                        Content="{Binding [flyout.scan], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding FixAllCommand}"
                        Content="{Binding [health.fixall], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                    Visibility="{Binding State.IsScanning,
                        Converter={x:Static Brisk:BoolToVis.Instance}}">
            <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                         Background="{DynamicResource Divider}"
                         Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}"
                           Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                           Text="{Binding State.ProgressText}" />
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="{Binding Message}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Emphasized completion report after a fix run on this page. -->
        <ContentControl DockPanel.Dock="Top" Focusable="False" Content="{Binding}"
                        ContentTemplate="{StaticResource CompletionReport}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <TextBlock Margin="0,10,0,6"
                           Text="{Binding [health.advise.section], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AdviseRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding AdviseRows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <!-- Where the rest of the findings live (category split):
                     a quiet link to the Performans page. -->
                <Button Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="2,10,0,0"
                        Foreground="{DynamicResource TextMuted}"
                        Command="{Binding CrossNavigateCommand}"
                        Content="{Binding CrossLinkText}"
                        Visibility="{Binding HasCrossLink,
                            Converter={x:Static Brisk:BoolToVis.Instance}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
