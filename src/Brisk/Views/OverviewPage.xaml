<UserControl x:Class="Brisk.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <UserControl.Resources>
        <!-- Live tile vocabulary: the existing card language (BgElevated,
             8px radius, 1px border) with a display-face numeral. -->
        <Style x:Key="LiveTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10,14,8" />
        </Style>
        <Style x:Key="TileNumeral" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,24" MaxWidth="640" HorizontalAlignment="Left">
            <!-- Hero: the health gauge with the machine's live vitals beside it. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="192" Height="192">
                    <Brisk:GaugeArc StrokeThickness="6"
                                    TrackBrush="{DynamicResource BorderBrushKey}"
                                    Score="{Binding ScoreValue}">
                        <Brisk:GaugeArc.Style>
                            <Style TargetType="{x:Type Brisk:GaugeArc}">
                                <Setter Property="ValueBrush"
                                        Value="{DynamicResource Good}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                 Value="SeverityWarning">
                                        <Setter Property="ValueBrush"
                                                Value="{DynamicResource SeverityWarning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                 Value="SeverityCritical">
                                        <Setter Property="ValueBrush"
                                                Value="{DynamicResource SeverityCritical}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Brisk:GaugeArc.Style>
                    </Brisk:GaugeArc>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource ScoreText}" FontSize="48"
                                   TextAlignment="Center" Text="{Binding ScoreText}" />
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0"
                                   TextAlignment="Center"
                                   Text="{Binding [flyout.health], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                            Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileNumeral}"
                                       Text="{Binding LiveCpuText}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,0"
                                       Text="{Binding [overview.live.cpu], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                            Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileNumeral}"
                                       Text="{Binding LiveRamText}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,0"
                                       Text="{Binding [overview.live.ram], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                            Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileNumeral}"
                                       Text="{Binding LiveTempText}" />
                            <!-- VM-composed: "Temperature · GPU" names the sensor. -->
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,0"
                                       Text="{Binding LiveTempCaption}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileNumeral}"
                                       Text="{Binding LiveDiskText}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,0"
                                       Text="{Binding [overview.live.disk], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Style="{StaticResource Body}" FontSize="13.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0"
                       Text="{Binding StatusText}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                       Text="{Binding SummaryText}" TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding State.IsScanning,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                             Background="{DynamicResource Divider}"
                             Foreground="{DynamicResource AccentBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                               Text="{Binding State.ProgressText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Margin="0,0,8,0" Command="{Binding ScanCommand}"
                        Content="{Binding [flyout.scan], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,8,0" Command="{Binding FixAllCommand}"
                        Content="{Binding [health.fixall], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding CleanSafeCommand}"
                        Content="{Binding [overview.cleansafe], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Border CornerRadius="8" Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                    Padding="16,12" Margin="0,20,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportLines.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6"
                               Text="{Binding [overview.report.title], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl ItemsSource="{Binding ReportLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Body}" Margin="0,2"
                                           TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Bottom line: only when the run actually did something. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportSummary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="1" Background="{DynamicResource Divider}"
                                Margin="0,8,0,8" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="{Binding ReportSummary}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding [overview.report.enjoy],
                                       Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,20,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,2"
                           Text="{Binding [overview.recent], Source={x:Static loc:Loc.Instance}}" />
                <!-- Why there is an undo button: these rows are completed
                     fixes, and every one of them is reversible. -->
                <TextBlock Style="{StaticResource Faint}" Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="{Binding [overview.recent.hint], Source={x:Static loc:Loc.Instance}}" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource Body}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="{Binding WhenText}" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Command="{Binding UndoCommand}"
                                            Content="{Binding [health.undo],
                                                Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
