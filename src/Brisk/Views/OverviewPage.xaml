<UserControl x:Class="Brisk.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <!-- The cockpit hero vocabulary (Hero* colors, brushes, HeroScore,
         HeroPod*) moved to Shared.xaml in round 11 — the page heroes on
         Sağlık, Performans and Depolama speak the same language. The ONE
         permitted glow, on this page, lives on the lit arc and on the
         satellites' floor pools and nowhere else; the gauge builds its
         DropShadowEffect in code (a shared XAML effect resource gets frozen, and a frozen
         Freezable cannot be animated). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,24" MaxWidth="{StaticResource ContentMaxWidth}">
            <!-- Cockpit hero: segmented ring + instrument pods + status
                 readout on one always-dark panel. The controls stay below,
                 on the page's normal surface. Round 7 adds the living
                 motion layer (orbit, comet, CPU ring, breathing glow,
                 sheen) — every perpetual clock is started/stopped by
                 code-behind through AmbientMotionController, riding the
                 same visibility signal as LiveMetrics. -->
            <Border x:Name="HeroPanel" CornerRadius="12"
                    Background="{StaticResource HeroSurface}"
                    BorderBrush="{StaticResource HeroHairline}" BorderThickness="1"
                    Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid x:Name="InstrumentDial" Width="260" Height="260">
                            <!-- Ambient orbit: ~90 faint hairline dashes on a
                                 ring 6 px outside the gauge, revolving once per
                                 30 s. Dash 3.2 + gap 5.56 at 1 px thickness
                                 gives a 8.76 px period over the 2π·125.5 ≈
                                 788.5 px circumference → 90 dashes. -->
                            <Ellipse Width="252" Height="252" IsHitTestVisible="False"
                                     Stroke="{StaticResource HeroOrbit}"
                                     StrokeThickness="1" StrokeDashArray="3.2 5.56"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OrbitSpin" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- The comet on the same orbit, one revolution per
                                 10 s. Hidden while ambient motion is off — a
                                 parked comet would read as a stray arc. -->
                            <Brisk:CometTail x:Name="CometLayer" Width="252" Height="252"
                                             Opacity="0" IsHitTestVisible="False"
                                             TailColor="{StaticResource HeroAccentColor}"
                                             RenderTransformOrigin="0.5,0.5">
                                <Brisk:CometTail.RenderTransform>
                                    <RotateTransform x:Name="CometSpin" />
                                </Brisk:CometTail.RenderTransform>
                            </Brisk:CometTail>
                            <!-- Two stacked layers of one control: the unlit
                                 track, then the lit arc wearing the glow. Both
                                 bind Score, so their sweeps stay in step. -->
                            <Brisk:SegmentedGauge Width="240" Height="240" Layer="Unlit"
                                                  UnlitBrush="{StaticResource HeroUnlit}"
                                                  Score="{Binding ScoreValue}" />
                            <Brisk:SegmentedGauge x:Name="LitGauge" Width="240" Height="240"
                                                  Layer="Lit" Score="{Binding ScoreValue}">
                                <Brisk:SegmentedGauge.Style>
                                    <Style TargetType="{x:Type Brisk:SegmentedGauge}">
                                        <Setter Property="LitBrush"
                                                Value="{StaticResource HeroGood}" />
                                        <Setter Property="GlowColor"
                                                Value="{StaticResource HeroGoodColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                         Value="SeverityNotice">
                                                <Setter Property="LitBrush"
                                                        Value="{StaticResource HeroNotice}" />
                                                <Setter Property="GlowColor"
                                                        Value="{StaticResource HeroNoticeColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                         Value="SeverityWarning">
                                                <Setter Property="LitBrush"
                                                        Value="{StaticResource HeroWarn}" />
                                                <Setter Property="GlowColor"
                                                        Value="{StaticResource HeroWarnColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                         Value="SeverityCritical">
                                                <Setter Property="LitBrush"
                                                        Value="{StaticResource HeroCrit}" />
                                                <Setter Property="GlowColor"
                                                        Value="{StaticResource HeroCritColor}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Brisk:SegmentedGauge.Style>
                            </Brisk:SegmentedGauge>
                            <!-- The two live arcs, just inside the ticks: pure
                                 data-driven motion (every ~2 s tick slews them),
                                 so they keep running under reduce-motion.
                                 The hero accent in its ring voice and in its
                                 quieter echo, never a semantic colour — the
                                 outer health ring is the instrument's only
                                 claim-carrier.

                                 Visibility, not a zero. A sensor that cannot be
                                 read gets NO arc: an empty arc is a picture of a
                                 measurement that does not exist, and this page
                                 drew one until this round. RAM rides a 226 box
                                 rather than a second Inset constant, which puts
                                 its centreline 7 px inside CPU's — 3.5 px of
                                 clear panel between two 3.5 px strokes. -->
                            <Brisk:SweepRing x:Name="CpuArc" Width="240" Height="240"
                                             IsHitTestVisible="False"
                                             Visibility="{Binding HasCpuArc,
                                                 Converter={x:Static Brisk:BoolToVis.Instance}}"
                                             RingBrush="{StaticResource HeroAccentRing}"
                                             Value="{Binding LiveCpuPercent}" />
                            <Brisk:SweepRing x:Name="RamArc" Width="226" Height="226"
                                             IsHitTestVisible="False"
                                             Visibility="{Binding HasRamArc,
                                                 Converter={x:Static Brisk:BoolToVis.Instance}}"
                                             RingBrush="{StaticResource HeroAccentRingDim}"
                                             Value="{Binding LiveRamPercent}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource HeroScore}"
                                           TextAlignment="Center" Text="{Binding ScoreText}" />
                                <TextBlock TextAlignment="Center" Margin="0,2,0,0"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="11" Foreground="{StaticResource HeroMuted}"
                                           Text="{Binding [overview.gauge.label], Source={x:Static loc:Loc.Instance}}" />
                                <!-- Compact temperature readout ("GPU 78°C"),
                                     only when a real sensor spoke. -->
                                <TextBlock TextAlignment="Center" Margin="0,6,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                           Foreground="{StaticResource HeroMuted}"
                                           Brisk:NumeralTick.Value="{Binding LiveTempBadgeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveTempBadgeText}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <!-- The satellites. Temperature and free space are part
                             of the instrument by composition rather than by
                             being forced into rings: neither has a natural
                             0–100 range, so a full sweep would have to be
                             invented, and every candidate makes a claim brisk
                             does not make. They keep the dash convention — the
                             number and its source when a sensor spoke, "—" when
                             none did. A dash STATES that nothing was read; an
                             empty arc would draw a measurement that does not
                             exist, which is the difference this whole round is
                             about. -->
                        <UniformGrid Rows="1" Columns="2" Width="260" Margin="0,6,0,0">
                            <Grid Margin="0,0,4,0">
                                <Ellipse Height="54" VerticalAlignment="Center"
                                         Style="{StaticResource SatelliteFloor}" />
                                <StackPanel Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SatelliteValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveTempText}" />
                                    <!-- VM-composed: "Temperature · GPU" names the sensor. -->
                                    <TextBlock Style="{StaticResource SatelliteCaption}"
                                               Text="{Binding LiveTempCaption}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="4,0,0,0">
                                <Ellipse Height="54" VerticalAlignment="Center"
                                         Style="{StaticResource SatelliteFloor}" />
                                <StackPanel Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SatelliteValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveDiskText}" />
                                    <TextBlock Style="{StaticResource SatelliteCaption}"
                                               Text="{Binding [overview.live.disk], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </Grid>
                        </UniformGrid>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- Two pods, then the two status lines. The
                                 temperature and free-space pods left this
                                 grid for the satellites under the ring. -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <!-- NumeralTick (not Text): each ticker
                                         update slides the new numeral in —
                                         the one transition mechanism shared
                                         by all pods and the temp badge. -->
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveCpuText}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [overview.live.cpu], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveRamText}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [overview.live.ram], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Status readout stays part of the instrument
                             panel; the action buttons live below the hero
                             on the page's normal surface. -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="2,12,0,0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13" Foreground="{StaticResource HeroText}"
                                   TextWrapping="Wrap" Text="{Binding StatusText}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="2,4,0,0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource HeroMuted}"
                                   TextWrapping="Wrap" Text="{Binding SummaryText}" />
                    </Grid>
                    <!-- Sheen sweep: a barely-there diagonal highlight
                         (white 0→4%→0, 120 px wide, tilted 20°) that
                         crosses the panel every ~9 s. Hosted in a Canvas so
                         the oversize band never stretches the hero's
                         layout; HeroPanel's code-set rounded clip keeps it
                         inside the panel. Idle X (−240) parks it fully
                         off-panel. -->
                    <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                        <Rectangle Width="120" Height="520" Canvas.Left="0"
                                   Canvas.Top="-110" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#0AFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="20" />
                                    <TranslateTransform x:Name="SheenSlide" X="-240" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Border>

            <!-- The revelation band: the scan's leading measured number on
                 the same always-dark surface as the cockpit. Static by
                 design — the cockpit already carries this page's motion. -->
            <Border Style="{StaticResource HeroStrip}" Margin="0,10,0,0"
                    Visibility="{Binding HasSnapshot,
                        Converter={x:Static Brisk:BoolToVis.Instance}}">
                <Grid>
                    <DockPanel Visibility="{Binding HasRevelation,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                        <StackPanel DockPanel.Dock="Left" Width="180"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HeroScore}" FontSize="40"
                                       Brisk:NumeralTick.Value="{Binding RevelationValue}" />
                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="{StaticResource HeroMuted}"
                                       Text="{Binding RevelationCaption}" />
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="{StaticResource HeroText}"
                                       Text="{Binding RevelationClaim}" />
                            <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="{StaticResource HeroMuted}"
                                       Text="{Binding RevelationEvidence}" />
                            <!-- The link is offered only when some page hosts
                                 the finding the band is showing; a privacy
                                 revelation has no host on this build, so the
                                 Button is collapsed rather than left live and
                                 inert. Its gap to the "and n more" line is its
                                 OWN right margin, so the line stays flush with
                                 the text above when the Button is gone. -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource LinkButton}"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasRevelationLink,
                                            Converter={x:Static Brisk:BoolToVis.Instance}}"
                                        Command="{Binding OpenFindingCommand}"
                                        Content="{Binding [overview.revelation.see], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Foreground="{StaticResource HeroMuted}"
                                           Text="{Binding RevelationMoreText}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="{StaticResource HeroMuted}"
                               Text="{Binding RevelationEmptyText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRevelation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding State.IsScanning,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                             Background="{DynamicResource Divider}"
                             Foreground="{DynamicResource AccentBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                               Text="{Binding State.ProgressText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Margin="0,0,8,0" Command="{Binding ScanCommand}"
                        Content="{Binding [flyout.scan], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,8,0" Command="{Binding FixAllCommand}"
                        Content="{Binding [health.fixall], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Round 11: the two action buttons read as two different
                     JOBS — "Speed up this PC" (settings fixes) next to
                     "Free up 1.2 GB" (junk files, wearing the live honest
                     figure). Same commands, same wiring as before. -->
                <Button Command="{Binding CleanSafeCommand}"
                        Content="{Binding CleanSafeText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <!-- Round-13 re-review (N1): ONE runner behind
                                     three clean buttons — while any surface is
                                     cleaning the others would be refused the
                                     lease, so they say so instead of going
                                     dead under the press. -->
                                <DataTrigger Binding="{Binding State.IsCleaning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Held closed by the same two conditions as its neighbours:
                     a card rendered while the snapshot underneath it is being
                     replaced would be a picture of a machine nobody is
                     looking at any more. -->
                <Button Margin="8,0,0,0" Command="{Binding SaveReportCommand}"
                        Content="{Binding [overview.report.card], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- The scan a person can actually show someone: the path the
                 card was written to, said once and quietly. -->
            <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="{Binding ReportSavedText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportSavedText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The reassurance the old "(güvenli)" parentheses carried, in
                 words a person actually reads. -->
            <TextBlock Style="{StaticResource Faint}" Margin="2,6,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding [overview.actions.hint], Source={x:Static loc:Loc.Instance}}" />

            <!-- THE report block (shared template): the run story right
                 after an action, the journal-driven "Yapılanlar raporu"
                 otherwise. The old hint line and hover-revealed undo links
                 are gone (round 9) — undo rides each journal row's context
                 menu instead. -->
            <ContentControl Focusable="False" Content="{Binding}"
                            ContentTemplate="{StaticResource CompletionReport}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
