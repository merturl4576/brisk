<UserControl x:Class="Brisk.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <UserControl.Resources>
        <!-- Cockpit hero vocabulary — still hero-LOCAL, but since round 8 the
             global DARK palette speaks the same language: Bg/BgElevated are
             the hero's graphite (#0E1116/#151A21) and Good/SeverityWarning/
             SeverityCritical are these same bright variants. The locals stay
             because the hero is an always-dark instrument panel in BOTH
             themes — under the explicit light theme these keys are what keep
             it dark, so they must not follow the theme dictionaries. -->
        <Color x:Key="HeroGoodColor">#4ADE80</Color>
        <Color x:Key="HeroWarnColor">#FBBF24</Color>
        <Color x:Key="HeroCritColor">#F87171</Color>
        <SolidColorBrush x:Key="HeroGood" Color="{StaticResource HeroGoodColor}" />
        <SolidColorBrush x:Key="HeroWarn" Color="{StaticResource HeroWarnColor}" />
        <SolidColorBrush x:Key="HeroCrit" Color="{StaticResource HeroCritColor}" />
        <SolidColorBrush x:Key="HeroText" Color="#F2F4F8" />
        <SolidColorBrush x:Key="HeroMuted" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="HeroUnlit" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HeroHairline" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="HeroPodFill" Color="#0AFFFFFF" />
        <Color x:Key="HeroAccentColor">#4CC2FF</Color>
        <SolidColorBrush x:Key="HeroAccent" Color="{StaticResource HeroAccentColor}" />
        <!-- Living-cockpit motion paints: the orbit's hairline dashes (13%
             white) and the inner CPU ring's 70%-opacity accent. -->
        <SolidColorBrush x:Key="HeroOrbit" Color="#21FFFFFF" />
        <SolidColorBrush x:Key="HeroAccentRing" Color="#B34CC2FF" />

        <!-- The ONE permitted gradient: a soft radial vignette, a touch
             lighter behind the ring and settling into deep graphite at the
             edges (~3–4% luminance shift, not a spotlight). The stops are
             exactly BgElevated → Bg of the dark palette, so on the dark
             theme the panel melts into the page and only its hairline and
             the lift behind the ring set it apart. -->
        <RadialGradientBrush x:Key="HeroSurface" Center="0.25,0.5"
                             GradientOrigin="0.25,0.5" RadiusX="0.75" RadiusY="1.2">
            <GradientStop Color="#151A21" Offset="0" />
            <GradientStop Color="#0E1116" Offset="1" />
        </RadialGradientBrush>

        <!-- The ONE permitted glow still lives on the lit arc only, but the
             gauge now builds the DropShadowEffect itself (see GlowColor):
             a shared XAML effect resource gets frozen and a frozen Freezable
             cannot be animated — and round 7's breathing animates it. -->

        <!-- Digital numerals: the score in mono, colored by the shared
             score → brush-key mapping (hero-bright variants of it). -->
        <Style x:Key="HeroScore" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="56" />
            <Setter Property="Foreground" Value="{StaticResource HeroText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ScoreBrushKey}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource HeroGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityWarning">
                    <Setter Property="Foreground" Value="{StaticResource HeroWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityCritical">
                    <Setter Property="Foreground" Value="{StaticResource HeroCrit}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Instrument pods: transparent-dark chips with a hairline edge and
             a 2px accent left-rule. No glow here — the ring owns the glow. -->
        <Style x:Key="HeroPod" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource HeroPodFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource HeroHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9,12,8" />
        </Style>
        <Style x:Key="HeroPodValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Foreground" Value="{StaticResource HeroText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeroPodCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource HeroMuted}" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,24" MaxWidth="{StaticResource ContentMaxWidth}">
            <!-- Cockpit hero: segmented ring + instrument pods + status
                 readout on one always-dark panel. The controls stay below,
                 on the page's normal surface. Round 7 adds the living
                 motion layer (orbit, comet, CPU ring, breathing glow,
                 sheen) — every perpetual clock is started/stopped by
                 code-behind through AmbientMotionController, riding the
                 same visibility signal as LiveMetrics. -->
            <Border x:Name="HeroPanel" CornerRadius="12"
                    Background="{StaticResource HeroSurface}"
                    BorderBrush="{StaticResource HeroHairline}" BorderThickness="1"
                    Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="260" Height="260">
                        <!-- Ambient orbit: ~90 faint hairline dashes on a
                             ring 6 px outside the gauge, revolving once per
                             30 s. Dash 3.2 + gap 5.56 at 1 px thickness
                             gives a 8.76 px period over the 2π·125.5 ≈
                             788.5 px circumference → 90 dashes. -->
                        <Ellipse Width="252" Height="252" IsHitTestVisible="False"
                                 Stroke="{StaticResource HeroOrbit}"
                                 StrokeThickness="1" StrokeDashArray="3.2 5.56"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="OrbitSpin" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- The comet on the same orbit, one revolution per
                             10 s. Hidden while ambient motion is off — a
                             parked comet would read as a stray arc. -->
                        <Brisk:CometTail x:Name="CometLayer" Width="252" Height="252"
                                         Opacity="0" IsHitTestVisible="False"
                                         TailColor="{StaticResource HeroAccentColor}"
                                         RenderTransformOrigin="0.5,0.5">
                            <Brisk:CometTail.RenderTransform>
                                <RotateTransform x:Name="CometSpin" />
                            </Brisk:CometTail.RenderTransform>
                        </Brisk:CometTail>
                        <!-- Two stacked layers of one control: the unlit
                             track, then the lit arc wearing the glow. Both
                             bind Score, so their sweeps stay in step. -->
                        <Brisk:SegmentedGauge Width="240" Height="240" Layer="Unlit"
                                              UnlitBrush="{StaticResource HeroUnlit}"
                                              Score="{Binding ScoreValue}" />
                        <Brisk:SegmentedGauge x:Name="LitGauge" Width="240" Height="240"
                                              Layer="Lit" Score="{Binding ScoreValue}">
                            <Brisk:SegmentedGauge.Style>
                                <Style TargetType="{x:Type Brisk:SegmentedGauge}">
                                    <Setter Property="LitBrush"
                                            Value="{StaticResource HeroGood}" />
                                    <Setter Property="GlowColor"
                                            Value="{StaticResource HeroGoodColor}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                     Value="SeverityWarning">
                                            <Setter Property="LitBrush"
                                                    Value="{StaticResource HeroWarn}" />
                                            <Setter Property="GlowColor"
                                                    Value="{StaticResource HeroWarnColor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScoreBrushKey}"
                                                     Value="SeverityCritical">
                                            <Setter Property="LitBrush"
                                                    Value="{StaticResource HeroCrit}" />
                                            <Setter Property="GlowColor"
                                                    Value="{StaticResource HeroCritColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Brisk:SegmentedGauge.Style>
                        </Brisk:SegmentedGauge>
                        <!-- Live CPU ring just inside the ticks: pure
                             data-driven motion (every ~2 s tick slews it),
                             so it keeps running under reduce-motion. -->
                        <Brisk:SweepRing Width="240" Height="240"
                                         IsHitTestVisible="False"
                                         RingBrush="{StaticResource HeroAccentRing}"
                                         Value="{Binding LiveCpuPercent}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource HeroScore}"
                                       TextAlignment="Center" Text="{Binding ScoreText}" />
                            <TextBlock TextAlignment="Center" Margin="0,2,0,0"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource HeroMuted}"
                                       Text="{Binding [overview.gauge.label], Source={x:Static loc:Loc.Instance}}" />
                            <!-- Compact temperature readout ("GPU 78°C"),
                                 only when a real sensor spoke. -->
                            <TextBlock TextAlignment="Center" Margin="0,6,0,0"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       Foreground="{StaticResource HeroMuted}"
                                       Brisk:NumeralTick.Value="{Binding LiveTempBadgeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveTempBadgeText}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <!-- NumeralTick (not Text): each ticker
                                         update slides the new numeral in —
                                         the one transition mechanism shared
                                         by all pods and the temp badge. -->
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveCpuText}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [overview.live.cpu], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveRamText}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [overview.live.ram], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveTempText}" />
                                    <!-- VM-composed: "Temperature · GPU" names the sensor. -->
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding LiveTempCaption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Brisk:NumeralTick.Value="{Binding LiveDiskText}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [overview.live.disk], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Status readout stays part of the instrument
                             panel; the action buttons live below the hero
                             on the page's normal surface. -->
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="2,12,0,0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13" Foreground="{StaticResource HeroText}"
                                   TextWrapping="Wrap" Text="{Binding StatusText}" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="2,4,0,0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource HeroMuted}"
                                   TextWrapping="Wrap" Text="{Binding SummaryText}" />
                    </Grid>
                    <!-- Sheen sweep: a barely-there diagonal highlight
                         (white 0→4%→0, 120 px wide, tilted 20°) that
                         crosses the panel every ~9 s. Hosted in a Canvas so
                         the oversize band never stretches the hero's
                         layout; HeroPanel's code-set rounded clip keeps it
                         inside the panel. Idle X (−240) parks it fully
                         off-panel. -->
                    <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                        <Rectangle Width="120" Height="520" Canvas.Left="0"
                                   Canvas.Top="-110" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#0AFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="20" />
                                    <TranslateTransform x:Name="SheenSlide" X="-240" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding State.IsScanning,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                             Background="{DynamicResource Divider}"
                             Foreground="{DynamicResource AccentBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                               Text="{Binding State.ProgressText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Margin="0,0,8,0" Command="{Binding ScanCommand}"
                        Content="{Binding [flyout.scan], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,8,0" Command="{Binding FixAllCommand}"
                        Content="{Binding [health.fixall], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Round 11: the two action buttons read as two different
                     JOBS — "Speed up this PC" (settings fixes) next to
                     "Free up 1.2 GB" (junk files, wearing the live honest
                     figure). Same commands, same wiring as before. -->
                <Button Command="{Binding CleanSafeCommand}"
                        Content="{Binding CleanSafeText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- The reassurance the old "(güvenli)" parentheses carried, in
                 words a person actually reads. -->
            <TextBlock Style="{StaticResource Faint}" Margin="2,6,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding [overview.actions.hint], Source={x:Static loc:Loc.Instance}}" />

            <!-- THE report block (shared template): the run story right
                 after an action, the journal-driven "Yapılanlar raporu"
                 otherwise. The old hint line and hover-revealed undo links
                 are gone (round 9) — undo rides each journal row's context
                 menu instead. -->
            <ContentControl Focusable="False" Content="{Binding}"
                            ContentTemplate="{StaticResource CompletionReport}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
