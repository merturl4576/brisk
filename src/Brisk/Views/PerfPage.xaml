<UserControl x:Class="Brisk.Views.PerfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Brisk.Localization"
             xmlns:Brisk="clr-namespace:Brisk.Views">
    <Grid>
    <DockPanel Margin="18,16">
        <!-- Every docked band and the scroll content share the app's one
             content column (see ContentMaxWidth in Shared.xaml). -->
        <!-- Round 11 page hero: performance posture as instruments — the
             count of improvements actually made leads (mono numeral, the
             journal's truth), with the waiting findings and the startup
             load as pods. No fake score, no ambient clocks: everything
             here is a real number that moves only when the data does. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource HeroStrip}"
                MaxWidth="{StaticResource ContentMaxWidth}" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"
                            MinWidth="120">
                    <TextBlock Style="{StaticResource HeroScore}" FontSize="44"
                               Foreground="{StaticResource HeroText}"
                               Text="{Binding DoneRows.Count, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource HeroStripCaption}"
                               Margin="2,2,0,0"
                               Text="{Binding [perf.hero.done], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeroStripCaption}"
                               Text="{Binding [perf.title], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="14" Foreground="{StaticResource HeroText}"
                               Text="{Binding StatusLine}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource HeroPod}" Margin="0,0,10,0">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Text="{Binding Rows.Count, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [perf.hero.findings], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource HeroPod}">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="2"
                                           RadiusX="1" RadiusY="1" Margin="0,2,10,2"
                                           Fill="{StaticResource HeroAccent}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroPodValue}"
                                               Text="{Binding DataContext.Items.Count,
                                                   ElementName=StartupSection, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource HeroPodCaption}"
                                               Margin="0,2,0,0"
                                               Text="{Binding [perf.hero.startup], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   MaxWidth="{StaticResource ContentMaxWidth}"
                   Text="{Binding Message}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Emphasized completion report after a fix run on this page. -->
        <ContentControl DockPanel.Dock="Top" Focusable="False" Content="{Binding}"
                        MaxWidth="{StaticResource ContentMaxWidth}"
                        ContentTemplate="{StaticResource CompletionReport}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <!-- Round 5's static "optimized" checklist is gone (round 9):
                     the shared report block above now tells this page's done
                     story straight from the journal — brisk claims only what
                     it actually changed. -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <TextBlock Margin="0,10,0,6"
                           Text="{Binding [health.advise.section], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AdviseRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding AdviseRows}"
                              ItemTemplate="{StaticResource FindingCard}" />
                <!-- Where the rest of the findings live (category split):
                     a quiet link to the Sağlık page. -->
                <Button Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="2,10,0,0"
                        Foreground="{DynamicResource TextMuted}"
                        Command="{Binding CrossNavigateCommand}"
                        Content="{Binding CrossLinkText}"
                        Visibility="{Binding HasCrossLink,
                            Converter={x:Static Brisk:BoolToVis.Instance}}" />

                <StackPanel x:Name="StartupSection" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6"
                               Text="{Binding [startup.title], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                               Foreground="{DynamicResource SeverityWarning}"
                               Text="{Binding [startup.togglefailed], Source={x:Static loc:Loc.Instance}}"
                               Visibility="{Binding ToggleFailed,
                                   Converter={x:Static Brisk:BoolToVis.Instance}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" MinHeight="44" Padding="16,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource BgHover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel VerticalAlignment="Center">
                                        <CheckBox DockPanel.Dock="Right"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding IsEnabled}" />
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,14,0">
                                            <Ellipse Width="8" Height="8"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Fill="{DynamicResource SeverityWarning}"
                                                     ToolTip="{Binding [startup.heavy],
                                                         Source={x:Static loc:Loc.Instance}}"
                                                     Visibility="{Binding IsHeavy,
                                                         Converter={x:Static Brisk:BoolToVis.Instance}}" />
                                            <TextBlock Style="{StaticResource Faint}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Hive}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Body}"
                                                       Text="{Binding Name}" />
                                            <!-- Friendly line for known apps, or the
                                                 "system component" hint; unknown user
                                                 apps get no invented description. -->
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="{Binding Description}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource Faint}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
        <!-- A display mode change can blank the screen; this covers the page
             until the user confirms the picture is back, or the countdown
             restores the previous setting on its own. -->
        <Border Background="#CC000000" Panel.ZIndex="10"
                Visibility="{Binding PendingConfirmation,
                    Converter={x:Static Brisk:NullToVis.Instance}}">
            <Border Style="{StaticResource HeroStrip}" MaxWidth="420" Padding="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding [display-confirm.title],
                                   Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="{Binding [display-confirm.body],
                                   Source={x:Static loc:Loc.Instance}}" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding KeepDisplayCommand}"
                            Content="{Binding [display-confirm.keep],
                                Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
