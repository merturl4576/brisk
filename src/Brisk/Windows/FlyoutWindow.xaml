<Window x:Class="Brisk.Windows.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Brisk.Localization"
        xmlns:Brisk="clr-namespace:Brisk.Views"
        Width="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="True" Topmost="True"
        Background="{DynamicResource Bg}">
    <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">
        <StackPanel Margin="0,4">
            <DockPanel Margin="14,6,14,8">
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                           Text="{Binding [app.name], Source={x:Static loc:Loc.Instance}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{Binding [flyout.health], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock FontWeight="SemiBold" Margin="8,0,0,0"
                               Text="{Binding HealthText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthBrushKey}"
                                                 Value="Good">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthBrushKey}"
                                                 Value="SeverityWarning">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SeverityWarning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthBrushKey}"
                                                 Value="SeverityCritical">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SeverityCritical}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <Separator Background="{DynamicResource Divider}" Margin="0" />

            <StackPanel Orientation="Horizontal" Margin="16,8,16,0"
                        Visibility="{Binding HasSnapshot,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource SeverityWarning}"
                         VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Body}" Margin="8,0,0,0"
                           Text="{Binding FindingsLine}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,7,16,0"
                        Visibility="{Binding HasSnapshot,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Good}"
                         VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Body}" Margin="8,0,0,0"
                           Text="{Binding ReclaimLine}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,7,16,0"
                        Visibility="{Binding State.IsScanning,
                            Converter={x:Static Brisk:BoolToVis.Instance}}">
                <TextBlock Style="{StaticResource Muted}"
                           Text="{Binding [flyout.scanning], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Style="{StaticResource Faint}" Margin="6,0,0,0"
                           Text="{Binding State.ProgressText}" />
            </StackPanel>

            <UniformGrid Columns="2" Margin="14,10,14,4">
                <Button Margin="0,0,3,0" Command="{Binding FixAllCommand}"
                        Content="{Binding [flyout.fixall], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="3,0,0,0" Command="{Binding CleanSafeCommand}"
                        Content="{Binding [flyout.clean], Source={x:Static loc:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <!-- Round-13 re-review (N1): ONE runner behind
                                     three clean buttons — while any surface is
                                     cleaning the others would be refused the
                                     lease, so they say so instead of going
                                     dead under the press. -->
                                <DataTrigger Binding="{Binding State.IsCleaning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <!-- Round 13: the tray Clean frees the space for real now, so it
                 says so — one quiet line, only after a clean has run. -->
            <TextBlock Style="{StaticResource Faint}" Margin="16,7,16,0"
                       TextWrapping="Wrap" Text="{Binding LastCleanLine}"
                       Visibility="{Binding HasLastClean,
                           Converter={x:Static Brisk:BoolToVis.Instance}}" />

            <Separator Background="{DynamicResource Divider}" Margin="0,6,0,0" />
            <DockPanel Margin="14,8,14,6">
                <TextBlock Style="{StaticResource Faint}" Text="{Binding LastScanLine}" />
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenDetailsCommand}"
                        Content="{Binding [flyout.details], Source={x:Static loc:Loc.Instance}}" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
