<Window x:Class="Brisk.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Brisk.Localization"
        xmlns:views="clr-namespace:Brisk.Views"
        Title="brisk" Width="900" Height="600"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Nav rail: recessed a step below the page ground (BgRail), a
             hairline apart. Item glyphs ride the Tag slot of NavRadio —
             Segoe Fluent iconography, not localizable text. -->
        <Border Grid.Column="0" Background="{DynamicResource BgRail}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,12">
                <RadioButton x:Name="NavOverview" Style="{StaticResource NavBrand}"
                             GroupName="nav" IsChecked="True" Checked="Nav_Checked"
                             Content="{Binding [app.name], Source={x:Static loc:Loc.Instance}}" />
                <Border Height="1" Margin="20,8" Background="{DynamicResource Divider}" />
                <RadioButton x:Name="NavHealth" Style="{StaticResource NavRadio}"
                             GroupName="nav" Checked="Nav_Checked" Tag="&#xE95E;"
                             Content="{Binding [nav.health], Source={x:Static loc:Loc.Instance}}" />
                <RadioButton x:Name="NavPerf" Style="{StaticResource NavRadio}"
                             GroupName="nav" Checked="Nav_Checked" Tag="&#xEC4A;"
                             Content="{Binding [nav.performance], Source={x:Static loc:Loc.Instance}}" />
                <RadioButton x:Name="NavClean" Style="{StaticResource NavRadio}"
                             GroupName="nav" Checked="Nav_Checked" Tag="&#xEDA2;"
                             Content="{Binding [nav.clean], Source={x:Static loc:Loc.Instance}}" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}"
                             GroupName="nav" Checked="Nav_Checked" Tag="&#xE713;"
                             Content="{Binding [nav.settings], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <views:OverviewPage x:Name="OverviewView" />
            <views:HealthPage x:Name="HealthView" Visibility="Collapsed" />
            <views:PerfPage x:Name="PerfView" Visibility="Collapsed" />
            <views:CleanPage x:Name="CleanView" Visibility="Collapsed" />
            <views:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
        </Grid>
        <!-- A display mode change can blank the screen. This lives here, not
             on any one page, because Fix all on EITHER findings page (and
             the tray's Fix all) can trigger it — the window's DataContext is
             the shared AppState, so the prompt covers whichever page is
             showing no matter which button started the fix. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#CC000000"
                Visibility="{Binding PendingConfirmation,
                    Converter={x:Static views:NullToVis.Instance}}">
            <Border Style="{StaticResource HeroStrip}" MaxWidth="420" Padding="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding [display-confirm.title],
                                   Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="{Binding [display-confirm.body],
                                   Source={x:Static loc:Loc.Instance}}" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding KeepDisplayCommand}"
                            Content="{Binding [display-confirm.keep],
                                Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
