<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Round 8: the dark theme IS the cockpit. The hero's graphite world
         (base #0E1116) is promoted to the whole app, so the overview's
         instrument panel no longer floats as an island — every page sits on
         the same ground. Key NAMES are the Task 8 contract; values only. -->
    <SolidColorBrush x:Key="Bg" Color="#0E1116" />
    <!-- The nav rail sits one step below the page ground, like the recessed
         side of an instrument bay; the content area reads as the lit panel. -->
    <SolidColorBrush x:Key="BgRail" Color="#0B0E12" />
    <SolidColorBrush x:Key="BgElevated" Color="#151A21" />
    <SolidColorBrush x:Key="BgHover" Color="#1B2129" />
    <!-- Hairlines: ~8–10% white over Bg, pre-composed to solid graphite so
         stacked translucent borders can never double-brighten. -->
    <SolidColorBrush x:Key="BorderBrushKey" Color="#1E242C" />
    <SolidColorBrush x:Key="Divider" Color="#1A2027" />
    <SolidColorBrush x:Key="Text" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA3AD" />
    <SolidColorBrush x:Key="TextFaint" Color="#5E6772" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B0B0B" />
    <!-- Severity/Good adopt the hero's bright variants (round 6), so the
         ring, the finding dots and the score speak one color vocabulary. -->
    <SolidColorBrush x:Key="SeverityInfo" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SeverityWarning" Color="#FBBF24" />
    <SolidColorBrush x:Key="SeverityCritical" Color="#F87171" />
    <SolidColorBrush x:Key="Good" Color="#4ADE80" />
</ResourceDictionary>
