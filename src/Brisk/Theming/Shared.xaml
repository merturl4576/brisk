<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:views="clr-namespace:Brisk.Views"
                    xmlns:loc="clr-namespace:Brisk.Localization">

    <!-- One reading column for every page: content is capped at this width
         and centers itself in whatever the window offers (WPF arranges a
         width-capped Stretch element centered), so a maximized window gets
         balanced gutters instead of content pinned left against a desert.
         Scroll viewers stay full-width — the scrollbar keeps the window
         edge — and only their content takes the cap. -->
    <sys:Double x:Key="ContentMaxWidth">720</sys:Double>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <!-- The micro-label, and it stays a micro-label. It sits above a combo
         box on Ayarlar and beside a button on Depolama, where a banded
         heading would be furniture — PanelHeader below is what opens a
         SECTION, and the two are deliberately different jobs. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="14,8,14,2" />
    </Style>

    <!-- ==================================================================
         THE PANEL LANGUAGE

         One sentence, three keys: a panel is a Surface fill inside a
         Hairline edge wearing four lit corner brackets, and a section of
         panels opens with a SurfaceHi header strip.

         They live HERE rather than on the pages on purpose. The cards on
         Sağlık, Performans and Depolama are FindingCard and CompletionReport
         further down this same file, so pointing those two at these keys is
         what let three pages change their look without any of the three
         being restructured. A page that writes Background and BorderBrush
         out by hand has left the language and will drift out of it; the ones
         that still did — Depolama's three cards — name the panel now.
         ================================================================== -->

    <!-- One corner, drawn once; the other three are this geometry mirrored,
         so there is a single set of numbers and four corners that cannot
         drift apart. DRAWN, never lifted: the concept this came from is a
         picture, and a raster corner in a theme dictionary cannot follow a
         palette, a DPI or a theme switch.

         14 along each arm with a 3-radius elbow, and the 3 is arithmetic
         rather than taste. The panel's corner is an 8-radius arc under a 1px
         edge, so the INSIDE of that corner turns at 7; a mark held 4 in from
         it stays concentric with it only if it turns at 7 − 4. It is inset
         by its own Margin for the same reason — a right-angled bracket drawn
         ON a rounded corner pokes out through it.

         This is also the one thing this round adds that emits light, so it
         carries its own contrast check (PanelSourceTests) rather than
         leaning on the atmosphere's, which was spent at the tuning gate. It
         never touches that budget: a bracket is only ever drawn on the
         opaque Surface fill of the panel it belongs to, never on bare sky. -->
    <Style x:Key="PanelBracket" TargetType="Path">
        <Setter Property="Data" Value="M 0,14 L 0,3 A 3,3 0 0 1 3,0 L 14,0" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <!-- The four corners as one line. A Control carrying nothing but a
         template is how XAML lends a SET of elements to more than one
         parent: a resource is one instance and an instance has one parent,
         so a shared Grid of four Paths could be used in exactly one panel. -->
    <ControlTemplate x:Key="PanelBrackets" TargetType="Control">
        <Grid>
            <Path Style="{StaticResource PanelBracket}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Style="{StaticResource PanelBracket}"
                  HorizontalAlignment="Right" VerticalAlignment="Top">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource PanelBracket}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Path.RenderTransform>
                    <ScaleTransform ScaleY="-1" />
                </Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource PanelBracket}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                </Path.RenderTransform>
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- A panel: the fill, the edge, the corner and the brackets, as one
         thing. It is a templated ContentControl rather than a Style on
         Border because a Style cannot give an element children, and a panel
         whose brackets had to be remembered separately at every use site
         would be a panel that arrives without them somewhere.

         Padding sits on the CONTENT, not on the Border, which is what keeps
         the brackets on the panel's edge: a Border's Padding pushes its
         whole child in, and the brackets are part of that child.

         Hairline, not BorderBrushKey. The two carry the same value today and
         different jobs — the dark palette names Hairline as the panel edge
         and BorderBrushKey as the control edge, and they are expected to
         part the first time either is tuned.

         Focusable and IsTabStop are the price of the ContentControl, and
         they are not optional. Control OVERRIDES Focusable to true and
         IsTabStop defaults true, so every panel below would otherwise be
         a keyboard tab stop wearing the dotted marching-ants rectangle
         that round 11 wrote Win11FocusVisual to remove — six of them,
         each standing between a keyboard user and a control that does
         something. A plain Border was none of that, so this is behaviour
         changed by a reskin, and it shipped once already. Nothing here
         touches the panel CONTENTS: Focusable does not inherit, so the
         expander, the buttons and the journal rows keep their focus. -->
    <Style x:Key="CockpitPanel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Control Template="{StaticResource PanelBrackets}"
                                     Focusable="False" IsTabStop="False"
                                     IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The header strip: a SurfaceHi band the width of the content column,
         in large light type, opening a section of panels.

         It is NOT BasedOn Body, and that is the whole of the wrap guard.
         Body sets TextTrimming="CharacterEllipsis", so the obvious build of
         this style would have inherited an ellipsis — and the header carries
         the widest text in the panel, in the language that runs longest:
         "brisk'in yalnızca bildirebildikleri" against "What brisk can only
         report". A trimming header eats the end of that sentence and nothing
         in the file says so, which is why PanelSourceTests walks the whole
         BasedOn chain instead of reading one setter. -->
    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceHi}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Round 11: Windows 11-style focus ring in place of WPF's dotted
         marching ants — a rounded hairline in the theme's text color,
         drawn just outside the control. Keyboard-focus only, exactly like
         the default FocusVisualStyle it replaces: the framework applies it
         under keyboard cues, so keyboard accessibility is untouched. -->
    <Style x:Key="Win11FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6"
                               StrokeThickness="1.6" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- Disabled means "nothing left to do", so the accent
                             fill goes away entirely: a quiet neutral chip reads
                             as intentional rest, not as a broken button. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch skin for on/off CheckBoxes (startup programs). Pure
         template work: the two-way IsChecked binding is untouched. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                            Background="{DynamicResource BgHover}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="14" Height="14"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="2,0,0,0" Fill="{DynamicResource TextMuted}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{DynamicResource AccentTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet selection checkbox: smaller box, subtle border, accent fill. -->
    <Style x:Key="QuietCheck" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3.5"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="1" Background="Transparent"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Glyph" Data="M 2 5.5 L 4.8 8 L 9.4 2.6"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Text" Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Text" Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default WPF chrome (Aero2) assumes a light ground; on the cockpit's
         navy it would glare. These implicit styles rebuild the three
         stock controls the app still uses — ComboBox, ScrollBar, ToolTip —
         from the theme brushes, so they follow light AND dark. Flat
         surfaces, hairline borders, no gloss. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="4" MinHeight="30"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True" />
                        <!-- Transparent press surface; the chrome Border above
                             carries the visuals so hover can retint it. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Path Data="M 0 0 L 4.5 4.5 L 9 0" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextMuted}"
                              IsHitTestVisible="False" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,1,12,0" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="1" CornerRadius="6"
                                    Margin="0,4,0,4" Padding="4"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet slim scrollbar: transparent track (the page's Bg shows
         through), pill thumb that wakes up under the pointer. -->
    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pill" CornerRadius="3" Margin="2"
                            Background="{DynamicResource BgHover}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Context menu (the done-report rows' quiet Undo path): same flat
         elevated surface as the ComboBox popup and ToolTip. The default
         Aero2 menu chrome (gradients, icon gutter) would glare on the
         cockpit and is more furniture than one action needs. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                            Padding="12,7" MinWidth="110" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Score number colored by the shared score converter key; pages set
         their own FontSize (30 on Sağlık, 42 on the overview hero). -->
    <Style x:Key="ScoreText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityWarning">
                <Setter Property="Foreground" Value="{DynamicResource SeverityWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityCritical">
                <Setter Property="Foreground" Value="{DynamicResource SeverityCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================== -->
    <!-- Cockpit hero vocabulary (moved here from OverviewPage in  -->
    <!-- round 11 so every page can open with its own status hero).-->
    <!-- The hero is an always-dark instrument panel in BOTH       -->
    <!-- themes — under the explicit light theme these keys are    -->
    <!-- what keep it dark, so they must not follow the theme      -->
    <!-- dictionaries. That is why the Hero* colours below are     -->
    <!-- LITERALS rather than {DynamicResource}: the family speaks -->
    <!-- the dark palette's vocabulary — its Surface, its Bg, its  -->
    <!-- signature turquoise — and it has to go on speaking it     -->
    <!-- while the light dictionary is the one loaded. The brights -->
    <!-- (Good/SeverityWarning/SeverityCritical) it shares         -->
    <!-- outright; the grounds and the accent it copies, and each  -->
    <!-- copy names below the key it copies. The rest is the       -->
    <!-- hero's own and did not move: HeroText is opaque, and the  -->
    <!-- translucent lifts (HeroMuted, HeroUnlit, HeroHairline,    -->
    <!-- HeroPodFill, HeroOrbit) compose over whatever fill is     -->
    <!-- under them, so they followed the grounds by standing      -->
    <!-- still.                                                    -->
    <!-- ======================================================== -->
    <Color x:Key="HeroGoodColor">#4ADE80</Color>
    <Color x:Key="HeroNoticeColor">#22D3EE</Color>   <!-- copies SeverityNotice -->
    <Color x:Key="HeroWarnColor">#FBBF24</Color>
    <Color x:Key="HeroCritColor">#F87171</Color>
    <SolidColorBrush x:Key="HeroGood" Color="{StaticResource HeroGoodColor}" />
    <SolidColorBrush x:Key="HeroNotice" Color="{StaticResource HeroNoticeColor}" />
    <SolidColorBrush x:Key="HeroWarn" Color="{StaticResource HeroWarnColor}" />
    <SolidColorBrush x:Key="HeroCrit" Color="{StaticResource HeroCritColor}" />
    <SolidColorBrush x:Key="HeroText" Color="#F2F4F8" />
    <SolidColorBrush x:Key="HeroMuted" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="HeroUnlit" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HeroHairline" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HeroPodFill" Color="#0AFFFFFF" />
    <!-- The instrument's own accent, and it is brisk's signature turquoise:
         the same value the dark palette holds as AccentBrush, copied here
         rather than bound, for the reason the block above gives. Bound, the
         light dictionary would hand this panel its own AccentBrush — a teal
         darkened until white ink sits on it, which measures 2.70:1 on the
         fill below and 1.98:1 at the strength the CPU arc draws at, under
         the 3:1 a graphical object has to clear. Its AccentDim, the QUIETER
         voice, measures 6.20:1 on the same fill: bind the theme's pair here
         and the echo comes out louder than the arc it echoes. -->
    <Color x:Key="HeroAccentColor">#5FD4E8</Color>
    <SolidColorBrush x:Key="HeroAccent" Color="{StaticResource HeroAccentColor}" />
    <!-- Living-cockpit motion paints (overview only): the orbit's hairline
         dashes (13% white) and the inner CPU ring's 70%-opacity accent.
         The accent is spelled out again with its alpha rather than layered
         on the Color key above, because a brush that carried the alpha as
         Opacity would read from source as full strength, and the arcs'
         contrast checks read from source. -->
    <SolidColorBrush x:Key="HeroOrbit" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="HeroAccentRing" Color="#B35FD4E8" />
    <!-- The inner RAM arc: the SAME hero accent at half strength, so the two
         live arcs read as one voice and its quieter echo. It is deliberately
         not a second hue and emphatically not a semantic colour — the outer
         health ring is the instrument's only claim-carrying element, and a
         RAM arc that turned amber at 80% would be a threshold judgment no
         rule in this app has made. At 50% it measures 3.36:1 on the panel's
         brightest ground against the CPU arc's 5.26:1 — clearly the second
         arc, and still clear of the 3:1 floor a graphical object has to
         hold. Those two figures are arithmetic written down beside the values
         and nothing checks them. What IS checked is the floor:
         InstrumentSourceTests reads these brushes and the ground under them
         out of source and fails if either arc drops through 3:1.

         Lightening the panel is what spends this arc's margin, and the margin
         is wider than the round that set it advertised: at half strength this
         turquoise still clears the floor on #12293B (3.29:1) and does not
         cross it until roughly #183853 (2.95:1). Re-measure before moving the
         fill; the figure that matters is this arc's, not the CPU arc's. -->
    <SolidColorBrush x:Key="HeroAccentRingDim" Color="#805FD4E8" />

    <!-- The ONE permitted gradient: a soft radial vignette, a touch lighter
         behind the ring and settling into the page's own night at the edges
         (a small shift, not a spotlight). The stops are the dark palette's
         Surface and Bg — the relationship this gradient always had, restored:
         it held that palette's graphite Surface and Bg until the cockpit
         retune turned the palette navy and left the instrument behind. -->
    <RadialGradientBrush x:Key="HeroSurface" Center="0.25,0.5"
                         GradientOrigin="0.25,0.5" RadiusX="0.75" RadiusY="1.2">
        <GradientStop Color="#0C2434" Offset="0" />
        <GradientStop Color="#0A1626" Offset="1" />
    </RadialGradientBrush>

    <!-- Digital numerals: the score in mono, colored by the shared
         score → brush-key mapping (hero-bright variants of it). -->
    <Style x:Key="HeroScore" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="Foreground" Value="{StaticResource HeroText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="Good">
                <Setter Property="Foreground" Value="{StaticResource HeroGood}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityNotice">
                <Setter Property="Foreground" Value="{StaticResource HeroNotice}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityWarning">
                <Setter Property="Foreground" Value="{StaticResource HeroWarn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityCritical">
                <Setter Property="Foreground" Value="{StaticResource HeroCrit}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Instrument pods: transparent-dark chips with a hairline edge and
         a 2px accent left-rule. No glow here — the ring owns the glow. -->
    <Style x:Key="HeroPod" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource HeroPodFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeroHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9,12,8" />
    </Style>
    <Style x:Key="HeroPodValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="Foreground" Value="{StaticResource HeroText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HeroPodCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource HeroMuted}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The page-hero strip (round 11): the same instrument panel, one
         size lighter — Sağlık, Performans and Depolama each open with one.
         No orbit, no comet, no sheen: ambient motion stays an overview
         privilege; page heroes move only when their data does. -->
    <Style x:Key="HeroStrip" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource HeroSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeroHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style x:Key="HeroStripCaption" TargetType="TextBlock"
           BasedOn="{StaticResource HeroPodCaption}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The satellites: temperature and free space, standing on their own
         pools of light beneath the instrument. Neither value has a natural
         0–100 range, so neither gets an arc — a full sweep would have to be
         invented, and every candidate makes a claim brisk does not make.
         They are readouts, and they keep the product's dash convention.

         The floor is the one LIT element this page adds after the tuning
         gate, and it obeys the gate's rule by construction: the pool is
         drawn INSIDE the instrument panel, on that panel's own opaque fill,
         so no atmosphere pixel is ever brightened by it. What it still owes
         is its own contrast check, and InstrumentSourceTests reads the fill
         key, the peak opacity and the panel underneath out of source rather
         than being told them.

         AccentGlow, so a theme decides whether there is a glow at all: the
         light dictionary holds that key fully transparent and the pool
         simply is not there. The fade is an OpacityMask rather than a
         gradient of the colour itself, because a colour gradient running to
         Transparent interpolates through black and would ring each
         satellite with a dark halo — the same trap AtmosphereLayer's
         horizon glow documents. -->
    <Style x:Key="SatelliteFloor" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AccentGlow}" />
        <Setter Property="Opacity" Value="0.16" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#66FFFFFF" Offset="0.6" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SatelliteValue" TargetType="TextBlock"
           BasedOn="{StaticResource HeroPodValue}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="SatelliteCaption" TargetType="TextBlock"
           BasedOn="{StaticResource HeroPodCaption}">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- One finding card, shared by the Sağlık and Performans lists — and the
         reason two pages could change their look without either of them
         changing. Its STRUCTURE is untouched: marker at the left, headline,
         expander. What moved is the dress, from three brush attributes
         written out here to the panel every panel in the app now wears. -->
    <DataTemplate x:Key="FindingCard">
        <ContentControl Margin="0,0,0,8">
            <ContentControl.Style>
                <!-- BasedOn, not a copy: the hover fill is the only thing a
                     card says about itself that the panel does not say. -->
                <Style TargetType="ContentControl" BasedOn="{StaticResource CockpitPanel}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" MinHeight="44">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <DockPanel>
                        <!-- Severity dot plus a Good twin stacked beneath it:
                             the Fixed morph crossfades one into the other
                             (brush values are theme resources, so opacity is
                             the animatable channel). -->
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="SeverityDot" Width="10" Height="10">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource SeverityInfo}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeverityKey}"
                                                         Value="SeverityWarning">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SeverityWarning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SeverityKey}"
                                                         Value="SeverityCritical">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SeverityCritical}" />
                                            </DataTrigger>
                                            <!-- Advise rows are information, not
                                                 alarms: whatever severity the rule
                                                 reported, the marker is a hollow
                                                 neutral ring, never a warning dot.
                                                 Last trigger wins over the severity
                                                 ones above by style-trigger order. -->
                                            <DataTrigger Binding="{Binding IsAdvise}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="Transparent" />
                                                <Setter Property="Stroke"
                                                        Value="{DynamicResource TextFaint}" />
                                                <Setter Property="StrokeThickness"
                                                        Value="1.3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse x:Name="FixedDot" Width="10" Height="10"
                                     Opacity="0" IsHitTestVisible="False"
                                     Fill="{DynamicResource Good}" />
                        </Grid>
                        <!-- The measured number leads: findings that carry a
                             headline show it before their title. No headline,
                             no column — the row reads exactly as before. -->
                        <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="19" FontWeight="SemiBold"
                                   Style="{StaticResource Body}"
                                   Text="{Binding HeadlineValue}"
                                   Visibility="{Binding HasHeadline,
                                       Converter={x:Static views:BoolToVis.Instance}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <!-- Impact dots read as "how big is the problem",
                                 and a row only shows them where that is a
                                 reading. Advise rows swap them for the quiet
                                 category word instead; privacy rows have no
                                 measured impact at all — ImpactStars is 1 on
                                 every one of them because the field is
                                 documented 1..5, not because anything was
                                 measured. FindingRow.ShowsImpact answers for
                                 both, and the binding is what stops ●○○○○
                                 from claiming a measurement on the Gizlilik
                                 page. -->
                            <TextBlock x:Name="ImpactDots" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding ImpactText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource Faint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsImpact}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Faint}"
                                       Typography.Capitals="AllSmallCaps"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding CategoryText}"
                                       Visibility="{Binding IsAdvise,
                                           Converter={x:Static views:BoolToVis.Instance}}" />
                            <Path Data="M 0 0 L 4.5 4.5 L 9 0" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource TextFaint}"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}"
                                                         Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                        <!-- Title and its past-tense twin share one cell; the
                             Fixed morph crossfades between them. Under them,
                             for the rows that have one, the named loss: the
                             two privacy switches that cost the user something
                             say so on the CLOSED card, because a consequence
                             behind a fold is a consequence the user can flip
                             the switch without reading. A rule that declares
                             no cost has no key and no line here. -->
                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="TitleText" Style="{StaticResource Body}"
                                           Text="{Binding Title}" />
                                <TextBlock x:Name="DoneText" Style="{StaticResource Body}"
                                           Opacity="0" IsHitTestVisible="False"
                                           Text="{Binding DoneTitle}" />
                            </Grid>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource SeverityWarning}"
                                       Text="{Binding CostText}"
                                       Visibility="{Binding HasCost,
                                           Converter={x:Static views:BoolToVis.Instance}}" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>
                <StackPanel Margin="36,0,16,14"
                            Visibility="{Binding IsExpanded,
                                Converter={x:Static views:BoolToVis.Instance}}">
                    <!-- Fixable rows keep the raw evidence as their body;
                         advise rows speak the localized advice instead and
                         park the English evidence behind the details fold. -->
                    <TextBlock TextWrapping="Wrap" Text="{Binding Evidence}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvise}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{Binding AdviceText}"
                               Visibility="{Binding IsAdvise,
                                   Converter={x:Static views:BoolToVis.Instance}}" />
                    <ToggleButton IsChecked="{Binding IsDetailsShown}" Cursor="Hand"
                                  HorizontalAlignment="Left" Margin="0,6,0,0"
                                  Visibility="{Binding HasDetails,
                                      Converter={x:Static views:BoolToVis.Instance}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <TextBlock Style="{StaticResource Faint}"
                                           Text="{Binding [finding.details],
                                               Source={x:Static loc:Loc.Instance}}" />
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Text="{Binding Evidence}"
                               Visibility="{Binding IsDetailsShown,
                                   Converter={x:Static views:BoolToVis.Instance}}" />
                    <!-- UNDO is never a foreground action on a card (round 9):
                         that capability lives in the done-report rows'
                         context menu, where it belongs. What is here is Fix
                         and the two ways a card hands the reader somewhere
                         else — brisk's own Depolama page, and Windows' own
                         Settings app — each shown only on the rows that have
                         one. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="FixButton"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding FixCommand}"
                                Visibility="{Binding CanFix,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding [health.fix],
                                    Source={x:Static loc:Loc.Instance}}" />
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding OpenStorageCommand}"
                                Visibility="{Binding HasStorageAction,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding [finding.action.storage],
                                    Source={x:Static loc:Loc.Instance}}" />
                        <!-- The other kind of follow-up: the one that leaves
                             brisk altogether. It opens Windows' own Settings
                             app and stops there. The Recall row is what
                             carries it — brisk reports that policy and
                             refuses to write it, and this is the spec's
                             answer to that refusal ("state only, with a link
                             to Windows' own setting"). A ghost button beside
                             Fix rather than a link glyph, because it is the
                             same kind of thing "Open Storage" is: this card
                             is done talking, here is where you go next. -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding OpenWindowsSettingCommand}"
                                Visibility="{Binding HasWindowsSettingAction,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding WindowsSettingCaption}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ContentControl>
        <DataTemplate.Triggers>
            <!-- Working (fixing or undoing): buttons rest, the severity dot
                 pulses. This is the app's only looping animation and it stops
                 with the state (StopStoryboard on exit). -->
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <Setter TargetName="FixButton" Property="IsEnabled" Value="False" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="WorkingPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeverityDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.35" Duration="0:0:0.65"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="WorkingPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFixing}" Value="True">
                <Setter TargetName="FixButton" Property="Content"
                        Value="{Binding [finding.fixing],
                            Source={x:Static loc:Loc.Instance}}" />
            </DataTrigger>
            <!-- Fixed morph: severity dot crossfades to Good, the title to its
                 past-tense outcome, and the impact dots retire. One-shot; the
                 row keeps this face until the follow-up rescan rebuilds the
                 list (the view model delays that rescan past the morph). -->
            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                <Setter TargetName="FixButton" Property="IsEnabled" Value="False" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeverityDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FixedDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TitleText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DoneText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ImpactDots"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Report row text: a step up from Body — the report is the emotional
         payoff of pressing Düzelt, so its lines get to be a little fuller. -->
    <Style x:Key="ReportLine" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A 3px determinate hairline for real work in flight (the Depolama
         simple clean). No animation of its own: the indicator's width IS
         the engine's per-entry progress stream — data-driven, so it needs
         no reduce-motion or visibility gating (round-7 rule). -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="1.5"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- THE report block, shared by the overview, Sağlık and Performans
         pages — one chrome, two faces (bound to any VM exposing
         ReportLines/ReportSummary/DoneRows/DoneLead/ShowDoneReport):
         · run face: the story of the action just taken (✓ result, outcome
           lines, closing note), until the next scan starts a new story;
         · journal face: the standing "Yapılanlar raporu" — every fix still
           in effect, straight from the journal, newest first with dates.
         Undo now lives ONLY here (round 9): each journal row's right-click
         context menu (Shift+F10 with the row focused). No visible
         affordance, no hint line — present for the one user who goes
         looking, invisible to everyone else. The whole block collapses
         while both faces are empty, so there is never an empty frame. -->
    <DataTemplate x:Key="CompletionReport">
        <ContentControl x:Name="ReportChrome" Margin="0,14,0,14" Padding="16,14"
                        Style="{StaticResource CockpitPanel}">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
            <!-- A 2px Good rule on the left edge — the same accent-rule
                 vocabulary the hero pods speak, worn in the report's own
                 color. Identity, not ornament. -->
            <DockPanel>
                <Rectangle DockPanel.Dock="Left" Width="2" RadiusX="1" RadiusY="1"
                           Margin="0,2" Fill="{DynamicResource Good}" />
                <StackPanel Margin="14,0,0,0">
                    <StackPanel x:Name="SessionBlock">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4"
                                   Text="{Binding [overview.report.title],
                                       Source={x:Static loc:Loc.Instance}}" />
                        <!-- The ✓ and the result sentence carry the color and
                             weight; the paragraph itself stays in Text. -->
                        <DockPanel x:Name="ReportLead" Margin="0,2,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="✓" Margin="0,0,9,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Good}" />
                            <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"
                                       TextWrapping="Wrap" Text="{Binding ReportSummary}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReportLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8"
                                                 Margin="1,0,11,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Good}"
                                                 Visibility="{Binding IsDone,
                                                     Converter={x:Static views:BoolToVis.Instance}}" />
                                        <TextBlock Style="{StaticResource ReportLine}"
                                                   TextWrapping="Wrap" Text="{Binding Text}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ReportEnjoy" Style="{StaticResource Muted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding [overview.report.enjoy],
                                       Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                    <StackPanel x:Name="JournalBlock">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4"
                                   Text="{Binding [overview.recent],
                                       Source={x:Static loc:Loc.Instance}}" />
                        <DockPanel Margin="0,2,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="✓" Margin="0,0,9,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Good}" />
                            <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"
                                       TextWrapping="Wrap" Text="{Binding DoneLead}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding DoneRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="DoneRow" MinHeight="34" CornerRadius="6"
                                            Padding="8,0" Margin="0,1"
                                            Background="Transparent" Focusable="True">
                                        <Border.RenderTransform>
                                            <TranslateTransform />
                                        </Border.RenderTransform>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding UndoCommand}"
                                                          Header="{Binding [health.undo],
                                                              Source={x:Static loc:Loc.Instance}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel VerticalAlignment="Center">
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8"
                                                     Margin="1,0,11,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource Good}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Style="{StaticResource Faint}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding WhenText}" />
                                            <TextBlock Style="{StaticResource ReportLine}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Title}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Hover/focus only retint the row —
                                             nothing is revealed; the context
                                             menu is the whole story. -->
                                        <Trigger SourceName="DoneRow" Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="DoneRow" Property="Background"
                                                    Value="{DynamicResource BgHover}" />
                                        </Trigger>
                                        <Trigger SourceName="DoneRow"
                                                 Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="DoneRow" Property="Background"
                                                    Value="{DynamicResource BgHover}" />
                                        </Trigger>
                                        <!-- One-shot entry for rows born of a fix
                                             run in this session; the startup
                                             population stays still. -->
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DoneRow"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="DoneRow"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </ContentControl>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ReportLines.Count}" Value="0">
                <Setter TargetName="SessionBlock" Property="Visibility"
                        Value="Collapsed" />
                <!-- Leaving the empty state = a run just reported:
                     play the entrance. -->
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ReportChrome"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ReportChrome"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="8" To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowDoneReport}" Value="False">
                <Setter TargetName="JournalBlock" Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>
            <!-- Neither face has anything to say → no frame at all. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ReportLines.Count}" Value="0" />
                    <Condition Binding="{Binding ShowDoneReport}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ReportChrome" Property="Visibility"
                        Value="Collapsed" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding ReportSummary}" Value="">
                <Setter TargetName="ReportLead" Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="ReportEnjoy" Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A nav tile. Round 14 took the recessed rail away, so these no longer
         sit IN anything: they float directly on the window's atmosphere, and
         a floating tile has to carry its own edge and its own answer to
         "which page am I on".

         At rest it is an empty hairline outline on the night. Hovered it
         fills with SurfaceHi and takes the soft glow. Selected it fills the
         same way but takes the STRONG glow, the accent on its border and on
         its glyph, and the text weight — so hover and selection are never the
         same picture. That distinction is not decoration: between round 13
         and here, the checked pill and the rail behind it were both painted
         Surface, and the app spent two commits unable to say which page was
         showing.

         Tag carries the tile's Segoe Fluent glyph (iconography, not a
         localizable string), and EVERY tile has one now. There used to be an
         exception — a wordmark tile with its icon slot collapsed — and it
         was the one nav entry with no name of its own: it wore [app.name],
         which put "brisk" on the screen twice. The wordmark kept the title
         bar, where names live, and every nav entry now says where it goes
         with a label and a picture. The label sits UNDER the glyph and WRAPS
         rather than clips: Turkish runs longer than English ("Performans",
         "Depolama"), and an icon-only nav in an app whose whole point is
         being understandable would be a regression. -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tile" Width="88" MinHeight="70" CornerRadius="10"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Hairline}"
                            BorderThickness="1">
                        <StackPanel Margin="7,10" VerticalAlignment="Center">
                            <!-- FontWeight pinned: the checked state's
                                 SemiBold must not fake-bold the icon font. -->
                            <TextBlock x:Name="Glyph" Margin="0,0,0,7"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="19" FontWeight="Normal"
                                       HorizontalAlignment="Center"
                                       Text="{TemplateBinding Tag}" />
                            <!-- A ContentPresenter handed a string builds a
                                 TextBlock that never wraps, so the label is
                                 given a template that does. Colour, size and
                                 weight arrive by inheritance from the tile,
                                 which is what lets the triggers below move
                                 all three at once. -->
                            <ContentPresenter HorizontalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   TextAlignment="Center" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover first, selection second: a trigger declared
                             later wins, so the tile the pointer is over while
                             it is also the selected one still reads selected. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background"
                                    Value="{DynamicResource SurfaceHi}" />
                            <Setter TargetName="Tile" Property="Effect"
                                    Value="{DynamicResource GlowSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tile" Property="Background"
                                    Value="{DynamicResource SurfaceHi}" />
                            <Setter TargetName="Tile" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tile" Property="Effect"
                                    Value="{DynamicResource GlowStrong}" />
                            <Setter TargetName="Glyph" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The caption controls of brisk's own title bar. Windows no longer
         paints minimize/maximize/close for us — WindowChrome hands the
         caption strip back to the app — so these three are ordinary Buttons,
         and every one of them needs WindowChrome.IsHitTestVisibleInChrome at
         its use site or the caption swallows the click before WPF sees it.
         Flat and transparent at rest: the atmosphere is the title bar's
         ground and a filled button would cut a hole in it.

         Tag is this template's second slot, the way it is the glyph slot on
         NavRadio — here it carries the foreground the button takes WHILE
         hovered, so close can go white on red without a second template. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
        <Setter Property="Tag" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{Binding Background,
                                        RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground"
                                    Value="{Binding Tag,
                                        RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close, which by every platform's convention goes red under the
         pointer. White ink on it in both themes: SeverityCritical is a
         strong fill in each, and the theme's own Text would be black on red
         in light. -->
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Background" Value="{DynamicResource SeverityCritical}" />
        <Setter Property="Tag">
            <Setter.Value>
                <SolidColorBrush Color="White" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
