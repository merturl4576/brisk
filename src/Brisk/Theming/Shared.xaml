<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Brisk.Views"
                    xmlns:loc="clr-namespace:Brisk.Localization">

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="14,8,14,2" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- Disabled means "nothing left to do", so the accent
                             fill goes away entirely: a quiet neutral chip reads
                             as intentional rest, not as a broken button. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch skin for on/off CheckBoxes (startup programs). Pure
         template work: the two-way IsChecked binding is untouched. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                            Background="{DynamicResource BgHover}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="14" Height="14"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="2,0,0,0" Fill="{DynamicResource TextMuted}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{DynamicResource AccentTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet selection checkbox: smaller box, subtle border, accent fill. -->
    <Style x:Key="QuietCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3.5"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="1" Background="Transparent"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Glyph" Data="M 2 5.5 L 4.8 8 L 9.4 2.6"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Text" Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Text" Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default WPF chrome (Aero2) assumes a light ground; on the cockpit's
         graphite it would glare. These implicit styles rebuild the three
         stock controls the app still uses — ComboBox, ScrollBar, ToolTip —
         from the theme brushes, so they follow light AND dark. Flat
         surfaces, hairline borders, no gloss. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="4" MinHeight="30"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True" />
                        <!-- Transparent press surface; the chrome Border above
                             carries the visuals so hover can retint it. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Path Data="M 0 0 L 4.5 4.5 L 9 0" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextMuted}"
                              IsHitTestVisible="False" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,1,12,0" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource BgElevated}"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="1" CornerRadius="6"
                                    Margin="0,4,0,4" Padding="4"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet slim scrollbar: transparent track (the page's Bg shows
         through), pill thumb that wakes up under the pointer. -->
    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pill" CornerRadius="3" Margin="2"
                            Background="{DynamicResource BgHover}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Score number colored by the shared score converter key; pages set
         their own FontSize (30 on Sağlık, 42 on the overview hero). -->
    <Style x:Key="ScoreText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityWarning">
                <Setter Property="Foreground" Value="{DynamicResource SeverityWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ScoreBrushKey}" Value="SeverityCritical">
                <Setter Property="Foreground" Value="{DynamicResource SeverityCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One finding card, shared by the Sağlık and Performans lists. -->
    <DataTemplate x:Key="FindingCard">
        <Border CornerRadius="8" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgElevated}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" MinHeight="44">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <DockPanel>
                        <!-- Severity dot plus a Good twin stacked beneath it:
                             the Fixed morph crossfades one into the other
                             (brush values are theme resources, so opacity is
                             the animatable channel). -->
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="SeverityDot" Width="10" Height="10">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource SeverityInfo}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeverityKey}"
                                                         Value="SeverityWarning">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SeverityWarning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SeverityKey}"
                                                         Value="SeverityCritical">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SeverityCritical}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse x:Name="FixedDot" Width="10" Height="10"
                                     Opacity="0" IsHitTestVisible="False"
                                     Fill="{DynamicResource Good}" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="ImpactDots"
                                       Style="{StaticResource Faint}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding ImpactText}" />
                            <Path Data="M 0 0 L 4.5 4.5 L 9 0" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource TextFaint}"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}"
                                                         Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                        <!-- Title and its past-tense twin share one cell; the
                             Fixed morph crossfades between them. -->
                        <Grid Margin="10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Style="{StaticResource Body}"
                                       Text="{Binding Title}" />
                            <TextBlock x:Name="DoneText" Style="{StaticResource Body}"
                                       Opacity="0" IsHitTestVisible="False"
                                       Text="{Binding DoneTitle}" />
                        </Grid>
                    </DockPanel>
                </ToggleButton>
                <StackPanel Margin="36,0,16,14"
                            Visibility="{Binding IsExpanded,
                                Converter={x:Static views:BoolToVis.Instance}}">
                    <!-- Fixable rows keep the raw evidence as their body;
                         advise rows speak the localized advice instead and
                         park the English evidence behind the details fold. -->
                    <TextBlock TextWrapping="Wrap" Text="{Binding Evidence}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvise}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{Binding AdviceText}"
                               Visibility="{Binding IsAdvise,
                                   Converter={x:Static views:BoolToVis.Instance}}" />
                    <ToggleButton IsChecked="{Binding IsDetailsShown}" Cursor="Hand"
                                  HorizontalAlignment="Left" Margin="0,6,0,0"
                                  Visibility="{Binding HasDetails,
                                      Converter={x:Static views:BoolToVis.Instance}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <TextBlock Style="{StaticResource Faint}"
                                           Text="{Binding [finding.details],
                                               Source={x:Static loc:Loc.Instance}}" />
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Text="{Binding Evidence}"
                               Visibility="{Binding IsDetailsShown,
                                   Converter={x:Static views:BoolToVis.Instance}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="FixButton"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding FixCommand}"
                                Visibility="{Binding CanFix,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding [health.fix],
                                    Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="UndoButton"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding UndoCommand}"
                                Visibility="{Binding CanUndo,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding [health.undo],
                                    Source={x:Static loc:Loc.Instance}}" />
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding OpenStorageCommand}"
                                Visibility="{Binding HasStorageAction,
                                    Converter={x:Static views:BoolToVis.Instance}}"
                                Content="{Binding [finding.action.storage],
                                    Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <!-- Working (fixing or undoing): buttons rest, the severity dot
                 pulses. This is the app's only looping animation and it stops
                 with the state (StopStoryboard on exit). -->
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <Setter TargetName="FixButton" Property="IsEnabled" Value="False" />
                <Setter TargetName="UndoButton" Property="IsEnabled" Value="False" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="WorkingPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeverityDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.35" Duration="0:0:0.65"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="WorkingPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFixing}" Value="True">
                <Setter TargetName="FixButton" Property="Content"
                        Value="{Binding [finding.fixing],
                            Source={x:Static loc:Loc.Instance}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUndoing}" Value="True">
                <Setter TargetName="UndoButton" Property="Content"
                        Value="{Binding [finding.undoing],
                            Source={x:Static loc:Loc.Instance}}" />
            </DataTrigger>
            <!-- Fixed morph: severity dot crossfades to Good, the title to its
                 past-tense outcome, and the impact dots retire. One-shot; the
                 row keeps this face until the follow-up rescan rebuilds the
                 list (the view model delays that rescan past the morph). -->
            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                <Setter TargetName="FixButton" Property="IsEnabled" Value="False" />
                <Setter TargetName="UndoButton" Property="IsEnabled" Value="False" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeverityDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FixedDot"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TitleText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DoneText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ImpactDots"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Post-run completion report, shared by the overview, Sağlık and
         Performans pages (bound to any VM exposing ReportLines/ReportSummary).
         Hidden until a run produces lines; the ✓ lead line and the closing
         note appear only when something actually ran. Entrance: one-shot
         fade+slide when the report (re)populates. -->
    <DataTemplate x:Key="CompletionReport">
        <Border x:Name="ReportChrome" CornerRadius="8" Margin="0,14,0,14"
                Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                Padding="16,12">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4"
                           Text="{Binding [overview.report.title],
                               Source={x:Static loc:Loc.Instance}}" />
                <!-- The ✓ and the result sentence carry the color and weight;
                     the paragraph itself stays in the Text brush. -->
                <DockPanel x:Name="ReportLead" Margin="0,2,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="✓" Margin="0,0,9,0"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Good}" />
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"
                               TextWrapping="Wrap" Text="{Binding ReportSummary}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ReportLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8"
                                         Margin="1,0,11,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Good}"
                                         Visibility="{Binding IsDone,
                                             Converter={x:Static views:BoolToVis.Instance}}" />
                                <TextBlock Style="{StaticResource Body}"
                                           TextWrapping="Wrap" Text="{Binding Text}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ReportEnjoy" Style="{StaticResource Muted}"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [overview.report.enjoy],
                               Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ReportLines.Count}" Value="0">
                <Setter TargetName="ReportChrome" Property="Visibility"
                        Value="Collapsed" />
                <!-- Leaving the empty state = the report just populated:
                     play the entrance. -->
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ReportChrome"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ReportChrome"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="8" To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ReportSummary}" Value="">
                <Setter TargetName="ReportLead" Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="ReportEnjoy" Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Nav item on the rail. Tag carries an optional Segoe Fluent glyph
         (iconography, not a localizable string); items without one — the
         brand — collapse the icon slot. Hover and the checked pill both use
         BgElevated, the one fill that reads on the recessed BgRail in both
         themes; selection is carried by the accent bar and the text weight,
         the Win11 nav-view way. -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="8,2">
                        <Border x:Name="Chrome" CornerRadius="5" MinHeight="34"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="12,0"
                                        VerticalAlignment="Center">
                                <!-- FontWeight pinned: the checked state's
                                     SemiBold must not fake-bold the icon font. -->
                                <TextBlock x:Name="Glyph" Margin="0,0,10,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Tag}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="Indicator" Width="3" Height="14"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgElevated}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgElevated}" />
                            <Setter TargetName="Indicator" Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "brisk" nav item: the app identity, still clearly a nav entry. -->
    <Style x:Key="NavBrand" TargetType="RadioButton" BasedOn="{StaticResource NavRadio}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
</ResourceDictionary>
