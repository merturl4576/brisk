<Window x:Class="Brisk.Ui.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Brisk.Ui.Controls"
        xmlns:ui="clr-namespace:Brisk.Ui"
        xmlns:home="clr-namespace:Brisk.Ui.Home"
        xmlns:pages="clr-namespace:Brisk.Ui.Pages"
        xmlns:shell="clr-namespace:Brisk.Ui.Shell"
        Title="brisk" MinWidth="720" MinHeight="460"
        WindowStartupLocation="Manual" Background="#050D14"
        FontFamily="{StaticResource Ui.Font}">
    <!-- The whole window is one 1100x680 design canvas, scaled uniformly, so
         every position from the chosen mockup carries over. The background
         fills the window edge to edge behind it. -->
    <Window.Resources>
        <ui:PresentToVisibility x:Key="Present" />
        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:GroupPageViewModel}">
            <pages:GroupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shell:UiSettingsViewModel}">
            <shell:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <c:Atmosphere Decorated="{Binding Decorated}" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1100" Height="680">
                <ContentControl Content="{Binding CurrentContent}" Focusable="False" />

                <!-- Mark and name -->
                <StackPanel Orientation="Horizontal" Margin="28,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Viewbox Width="30" Height="30">
                        <Canvas Width="256" Height="256">
                            <Path Data="M 58.7 197.3 A 98 98 0 1 1 197.3 197.3" Stroke="{StaticResource Ui.Accent}"
                                  StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="128" Y1="10" X2="128" Y2="52" Stroke="White" StrokeThickness="14"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="brisk" FontSize="26" FontWeight="Medium" Foreground="{StaticResource Ui.Text}"
                               Margin="12,-2,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav tiles -->
                <StackPanel Margin="26,88,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <RadioButton Style="{StaticResource Ui.Tile}" GroupName="nav" IsChecked="{Binding IsHome}"
                                 Tag="{Binding L[gui.nav.home]}" Margin="0,0,0,22">
                        <Path Style="{StaticResource Ui.Icon}" Data="{StaticResource Ui.Icon.Home}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Ui.Tile}" GroupName="nav" IsChecked="{Binding IsSpace}"
                                 Tag="{Binding L[gui.nav.space]}" Margin="0,0,0,22">
                        <Path Style="{StaticResource Ui.Icon}" Data="{StaticResource Ui.Icon.Space}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Ui.Tile}" GroupName="nav" IsChecked="{Binding IsSpeed}"
                                 Tag="{Binding L[gui.nav.speed]}" Margin="0,0,0,22">
                        <Path Style="{StaticResource Ui.Icon}" Data="{StaticResource Ui.Icon.Speed}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Ui.Tile}" GroupName="nav" IsChecked="{Binding IsPrivacy}"
                                 Tag="{Binding L[gui.nav.privacy]}">
                        <Path Style="{StaticResource Ui.Icon}" Data="{StaticResource Ui.Icon.Privacy}" />
                    </RadioButton>
                </StackPanel>
                <RadioButton Style="{StaticResource Ui.Tile}" GroupName="nav" IsChecked="{Binding IsSettings}"
                             Tag="{Binding L[gui.nav.settings]}" Margin="26,0,0,40"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Path Style="{StaticResource Ui.Icon}" Data="{StaticResource Ui.Icon.Settings}" />
                </RadioButton>

                <!-- The one confirmation -->
                <Grid Visibility="{Binding Sheet, Converter={StaticResource Present}}">
                    <Rectangle Fill="{StaticResource Ui.Dim}" />
                    <Border Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
                            Background="{StaticResource Ui.Panel}" BorderBrush="{StaticResource Ui.OutlineBorder}"
                            BorderThickness="1" Padding="28,24">
                        <StackPanel DataContext="{Binding Sheet}">
                            <TextBlock Style="{StaticResource Ui.H1}" FontSize="19" Text="{Binding Title}" Margin="0,0,0,14" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <TextBlock Style="{StaticResource Ui.RowTitle}" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,22,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ui.Primary}" Command="{Binding Go}"
                                        Content="{Binding GoText}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ui.Outline}" Command="{Binding Skip}"
                                        Content="{Binding SkipText}" Margin="0,0,12,0" />
                                <Button Style="{StaticResource Ui.Link}" Command="{Binding SeeList}" Content="{Binding ListText}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
