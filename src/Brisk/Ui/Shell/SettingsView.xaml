<UserControl x:Class="Brisk.Ui.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1100" Height="680">
    <UserControl.Resources>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="14" BorderThickness="1" Padding="14,5" Margin="0,0,8,0"
                                BorderBrush="{StaticResource Ui.OutlineBorder}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.AccentFaint}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Ui.Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="120,84,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Ui.H1}" Text="{Binding L[gui.settings.title]}" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Width="620" HorizontalAlignment="Left">
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Pill}" GroupName="language" IsChecked="{Binding IsSelected}">
                                    <TextBlock Style="{StaticResource Ui.Value}" Text="{Binding Label}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Ui.RowTitle}" VerticalAlignment="Center" Text="{Binding L[gui.settings.language]}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Ui.Switch}" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Style="{StaticResource Ui.RowTitle}" VerticalAlignment="Center" Text="{Binding L[gui.settings.autostart]}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Ui.Switch}" IsChecked="{Binding Motion}" />
                    <TextBlock Style="{StaticResource Ui.RowTitle}" VerticalAlignment="Center" Text="{Binding L[gui.settings.motion]}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Ui.MutedText}" Text="{Binding Version}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Ui.MutedText}" Text=" · " VerticalAlignment="Center" />
            <Button Style="{StaticResource Ui.Link}" Command="{Binding OpenGitHub}" Content="{Binding L[gui.settings.github]}" />
        </StackPanel>
    </Grid>
</UserControl>
