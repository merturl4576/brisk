<UserControl x:Class="Brisk.Ui.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1100" Height="680">
    <!-- Ayarlar on the stage: the same three settings and the GitHub link,
         nothing added. They stand in the centre, where the other places carry
         their gauge, in the stage's own block style (mockup .blk: rows on thin
         rules, numbers and controls on the right). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="StageRule" Color="#387F9AA8" />
        <!-- A choice: an outlined pill like a page row's, filled when chosen. -->
        <!-- The label inherits the pill's Foreground (its logical parent), so
             the colours sit on the style, not on the presenter. -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ui.BadgeText}" />
            <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="11" BorderThickness="1" Padding="11,3" Margin="6,0,0,0"
                                BorderBrush="{StaticResource Ui.BadgeBorder}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource StageRule}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,11" />
        </Style>
        <Style x:Key="RowName" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Width="440" Margin="0,112,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
        <TextBlock Style="{StaticResource Ui.H1}" Text="{Binding L[gui.settings.title]}" Margin="0,0,0,16" />

        <Border Style="{StaticResource Row}">
            <DockPanel>
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Languages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Choice}" GroupName="language" IsChecked="{Binding IsSelected}">
                                <TextBlock Text="{Binding Label}" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource RowName}" Text="{Binding L[gui.settings.language]}" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Ui.Switch}" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Style="{StaticResource RowName}" Text="{Binding L[gui.settings.autostart]}" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Ui.Switch}" IsChecked="{Binding Motion}" />
                <TextBlock Style="{StaticResource RowName}" Text="{Binding L[gui.settings.motion]}" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ui.MutedText}" Text="{Binding Version}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Ui.MutedText}" Text=" · " VerticalAlignment="Center" />
                <Button Style="{StaticResource Ui.Link}" Command="{Binding OpenGitHub}" Content="{Binding L[gui.settings.github]}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
