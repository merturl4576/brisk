<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Brisk.Ui.Controls">
    <!-- The new window's one palette (spec: navy-turquoise, accent #5fd4e8,
         green #3ecf8e). Every key is prefixed Ui. so it never collides with
         the report card's dictionaries. -->

    <Color x:Key="Ui.AccentColor">#5FD4E8</Color>
    <Color x:Key="Ui.GreenColor">#3ECF8E</Color>

    <RadialGradientBrush x:Key="Ui.Background" Center="0.5,0.32" GradientOrigin="0.5,0.32"
                         RadiusX="0.75" RadiusY="1.0">
        <GradientStop Color="#0F3549" Offset="0" />
        <GradientStop Color="#08222F" Offset="0.42" />
        <GradientStop Color="#050D14" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Ui.Accent" Color="#5FD4E8" />
    <SolidColorBrush x:Key="Ui.AccentSoft" Color="#735FD4E8" />
    <SolidColorBrush x:Key="Ui.AccentFaint" Color="#245FD4E8" />
    <SolidColorBrush x:Key="Ui.Green" Color="#3ECF8E" />
    <SolidColorBrush x:Key="Ui.Amber" Color="#E8B45F" />
    <SolidColorBrush x:Key="Ui.Red" Color="#E8705F" />
    <SolidColorBrush x:Key="Ui.Text" Color="#E6F4F8" />
    <SolidColorBrush x:Key="Ui.TextSoft" Color="#CFE8F2" />
    <SolidColorBrush x:Key="Ui.Muted" Color="#7FA3B1" />
    <SolidColorBrush x:Key="Ui.Unlit" Color="#1A3A48" />
    <SolidColorBrush x:Key="Ui.Line" Color="#1A3542" />
    <SolidColorBrush x:Key="Ui.OutlineBorder" Color="#2A4A5A" />
    <SolidColorBrush x:Key="Ui.Panel" Color="#0B2532" />
    <SolidColorBrush x:Key="Ui.PanelRaised" Color="#0F2E3D" />
    <SolidColorBrush x:Key="Ui.Dim" Color="#99000000" />
    <SolidColorBrush x:Key="Ui.ButtonText" Color="#03222B" />

    <FontFamily x:Key="Ui.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Ui.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <DropShadowEffect x:Key="Ui.Glow" Color="#5FD4E8" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="Ui.GlowSmall" Color="#5FD4E8" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />

    <!-- ===== Text ===== -->
    <Style x:Key="Ui.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Ui.H1" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Ui.Label" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ui.TextSoft}" />
    </Style>
    <Style x:Key="Ui.MutedText" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Muted}" />
    </Style>
    <Style x:Key="Ui.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Ui.RowCost" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Muted}" />
    </Style>
    <Style x:Key="Ui.Value" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Ui.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
        <Setter Property="Background" Value="{StaticResource Ui.Accent}" />
        <Setter Property="Padding" Value="28,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" Effect="{StaticResource Ui.Glow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#7FE0F0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#4BC0D4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Box" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Outline" TargetType="Button" BasedOn="{StaticResource Ui.Primary}">
        <Setter Property="Foreground" Value="{StaticResource Ui.TextSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="10" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource Ui.OutlineBorder}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent"
                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Check box: a ticked box means "do this" ===== -->
    <Style x:Key="Ui.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{StaticResource Ui.AccentSoft}" Background="Transparent"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="{StaticResource Ui.ButtonText}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Switch (settings) ===== -->
    <Style x:Key="Ui.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{StaticResource Ui.Unlit}">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource Ui.Muted}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ui.ButtonText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation tile: outlined square, label underneath (mockup
         .tile: 62 px, the label 17 px under it) ===== -->
    <Style x:Key="Ui.Tile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#BFE9F3" />
        <Setter Property="Width" Value="62" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <Border x:Name="Box" Width="62" Height="62" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{StaticResource Ui.AccentSoft}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Tag}" FontSize="10.5" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ui.Muted}"
                                   FontFamily="{StaticResource Ui.Font}" TextTrimming="None" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.AccentFaint}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Box" Property="Effect" Value="{StaticResource Ui.GlowSmall}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nav badge: a tile's number, spinner or tick in its top-right
         corner (mockup .tile i). Spinning wins over the tick, the tick over
         the number; no number and no state hides the pill. The spinner is
         built only while it spins, so a still badge costs no frames. ===== -->
    <SolidColorBrush x:Key="Ui.BadgeFill" Color="#0B2A36" />
    <SolidColorBrush x:Key="Ui.BadgeBorder" Color="#805FD4E8" />
    <SolidColorBrush x:Key="Ui.BadgeText" Color="#CFEFF7" />

    <DataTemplate x:Key="Ui.NavBadge.Still">
        <Canvas />
    </DataTemplate>
    <DataTemplate x:Key="Ui.NavBadge.Spinner">
        <Path Width="10" Height="10" Data="M5,1 A4,4 0 1 1 1,5" Stroke="{StaticResource Ui.Accent}"
              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              c:Ambient.Motion="Busy" />
    </DataTemplate>
    <DataTemplate x:Key="Ui.NavBadge.Template">
        <Border x:Name="Pill" CornerRadius="9" Padding="6,1" BorderThickness="1"
                Background="{StaticResource Ui.BadgeFill}" BorderBrush="{StaticResource Ui.BadgeBorder}">
            <Grid MinWidth="10" MinHeight="14">
                <TextBlock x:Name="Number" Text="{Binding Text}" FontFamily="{StaticResource Ui.Font}"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Ui.BadgeText}"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="Tick" Width="10" Height="10" Data="M1.5,5.5 L4,8 L8.5,2.5"
                      Stroke="{StaticResource Ui.Green}" StrokeThickness="1.6" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ContentControl x:Name="Spinner" Content="{Binding}" Focusable="False" IsTabStop="False"
                                ContentTemplate="{StaticResource Ui.NavBadge.Still}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Ui.Green}" />
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Spinning}" Value="True">
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Ui.BadgeBorder}" />
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Spinner" Property="ContentTemplate" Value="{StaticResource Ui.NavBadge.Spinner}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Laid over a tile's top-right corner: 8 px above it, 12 px past its edge. -->
    <Style x:Key="Ui.NavBadge" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-8,-12,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ContentTemplate" Value="{StaticResource Ui.NavBadge.Template}" />
    </Style>

    <!-- The outlined icons the tiles carry (24 px, stroke 1.6), from the mockup:
         Genel a monitor with a pulse, Yer aç a disk, Hızlandır a gauge,
         Gizlilik a shield, Ayarlar a gear. -->
    <Style x:Key="Ui.Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="#BFE9F3" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>
    <Geometry x:Key="Ui.Icon.Home">M4.5,4 L19.5,4 A1.5,1.5 0 0 1 21,5.5 L21,14.5 A1.5,1.5 0 0 1 19.5,16 L4.5,16 A1.5,1.5 0 0 1 3,14.5 L3,5.5 A1.5,1.5 0 0 1 4.5,4 Z M6,11 L9,11 L11,7 L13,14 L15,11 L18,11 M9,20 L15,20</Geometry>
    <Geometry x:Key="Ui.Icon.Space">M5,6 A7,2.6 0 1 1 19,6 A7,2.6 0 1 1 5,6 Z M5,6 L5,18 C5,19.4 8.1,20.6 12,20.6 C15.9,20.6 19,19.4 19,18 L19,6 M5,12 C5,13.4 8.1,14.6 12,14.6 C15.9,14.6 19,13.4 19,12</Geometry>
    <Geometry x:Key="Ui.Icon.Speed">M4,16 A8,8 0 1 1 20,16 M12,16 L16.5,11</Geometry>
    <Geometry x:Key="Ui.Icon.Privacy">M12,3 L19,6 L19,11 C19,15.6 16,19.4 12,21 C8,19.4 5,15.6 5,11 L5,6 Z</Geometry>
    <Geometry x:Key="Ui.Icon.Settings">M15.2,12 A3.2,3.2 0 1 1 8.8,12 A3.2,3.2 0 1 1 15.2,12 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>

    <!-- ===== Thin scroll bar for the pages ===== -->
    <Style x:Key="Ui.ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{StaticResource Ui.OutlineBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ui.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Ui.ThumbStyle}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ui.Scroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource Ui.ScrollBar}"
                                   Margin="4,0,0,0" Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
