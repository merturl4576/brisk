<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The new window's one palette (spec: navy-turquoise, accent #5fd4e8,
         green #3ecf8e). Every key is prefixed Ui. so it never collides with
         the report card's dictionaries. -->

    <Color x:Key="Ui.AccentColor">#5FD4E8</Color>
    <Color x:Key="Ui.GreenColor">#3ECF8E</Color>

    <RadialGradientBrush x:Key="Ui.Background" Center="0.5,0.32" GradientOrigin="0.5,0.32"
                         RadiusX="0.75" RadiusY="1.0">
        <GradientStop Color="#0F3549" Offset="0" />
        <GradientStop Color="#08222F" Offset="0.42" />
        <GradientStop Color="#050D14" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Ui.Accent" Color="#5FD4E8" />
    <SolidColorBrush x:Key="Ui.AccentSoft" Color="#735FD4E8" />
    <SolidColorBrush x:Key="Ui.AccentFaint" Color="#245FD4E8" />
    <SolidColorBrush x:Key="Ui.Green" Color="#3ECF8E" />
    <SolidColorBrush x:Key="Ui.Amber" Color="#E8B45F" />
    <SolidColorBrush x:Key="Ui.Red" Color="#E8705F" />
    <SolidColorBrush x:Key="Ui.Text" Color="#E6F4F8" />
    <SolidColorBrush x:Key="Ui.TextSoft" Color="#CFE8F2" />
    <SolidColorBrush x:Key="Ui.Muted" Color="#7FA3B1" />
    <SolidColorBrush x:Key="Ui.Unlit" Color="#1A3A48" />
    <SolidColorBrush x:Key="Ui.Line" Color="#1A3542" />
    <SolidColorBrush x:Key="Ui.OutlineBorder" Color="#2A4A5A" />
    <SolidColorBrush x:Key="Ui.Panel" Color="#0B2532" />
    <SolidColorBrush x:Key="Ui.PanelRaised" Color="#0F2E3D" />
    <SolidColorBrush x:Key="Ui.Dim" Color="#99000000" />
    <SolidColorBrush x:Key="Ui.ButtonText" Color="#03222B" />

    <FontFamily x:Key="Ui.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Ui.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <DropShadowEffect x:Key="Ui.Glow" Color="#5FD4E8" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="Ui.GlowSmall" Color="#5FD4E8" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />

    <!-- ===== Text ===== -->
    <Style x:Key="Ui.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Ui.H1" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Ui.Label" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ui.TextSoft}" />
    </Style>
    <Style x:Key="Ui.MutedText" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Muted}" />
    </Style>
    <Style x:Key="Ui.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Ui.RowCost" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Muted}" />
    </Style>
    <Style x:Key="Ui.Value" TargetType="TextBlock" BasedOn="{StaticResource Ui.TextBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Ui.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
        <Setter Property="Background" Value="{StaticResource Ui.Accent}" />
        <Setter Property="Padding" Value="28,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" Effect="{StaticResource Ui.Glow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#7FE0F0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#4BC0D4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Box" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Outline" TargetType="Button" BasedOn="{StaticResource Ui.Primary}">
        <Setter Property="Foreground" Value="{StaticResource Ui.TextSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="10" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource Ui.OutlineBorder}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent"
                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Check box: a ticked box means "do this" ===== -->
    <Style x:Key="Ui.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Ui.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{StaticResource Ui.AccentSoft}" Background="Transparent"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="{StaticResource Ui.ButtonText}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Switch (settings) ===== -->
    <Style x:Key="Ui.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{StaticResource Ui.Unlit}">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource Ui.Muted}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ui.ButtonText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation tile: outlined square, label underneath ===== -->
    <Style x:Key="Ui.Tile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#BFE9F3" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <Border x:Name="Box" Width="64" Height="64" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{StaticResource Ui.AccentSoft}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Tag}" FontSize="10" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ui.Muted}"
                                   FontFamily="{StaticResource Ui.Font}" TextTrimming="None" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.AccentFaint}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                            <Setter TargetName="Box" Property="Effect" Value="{StaticResource Ui.GlowSmall}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The outlined icons the tiles carry (24 px, stroke 1.6), from the mockup. -->
    <Style x:Key="Ui.Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="#BFE9F3" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>
    <Geometry x:Key="Ui.Icon.Home">M4,16 A8,8 0 1 1 20,16 M12,16 L16,11</Geometry>
    <Geometry x:Key="Ui.Icon.Space">M6,5 L18,5 A2,2 0 0 1 20,7 L20,17 A2,2 0 0 1 18,19 L6,19 A2,2 0 0 1 4,17 L4,7 A2,2 0 0 1 6,5 Z M8,15 L16,15</Geometry>
    <Geometry x:Key="Ui.Icon.Speed">M13,3 L5,14 L11,14 L10,21 L18,10 L12,10 Z</Geometry>
    <Geometry x:Key="Ui.Icon.Privacy">M12,3 L19,6 L19,11 C19,16 16,19 12,21 C8,19 5,16 5,11 L5,6 Z</Geometry>
    <Geometry x:Key="Ui.Icon.Settings">M12,8.5 A3.5,3.5 0 1 1 11.99,8.5 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>

    <!-- ===== Thin scroll bar for the pages ===== -->
    <Style x:Key="Ui.ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{StaticResource Ui.OutlineBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ui.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Ui.ThumbStyle}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ui.Scroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource Ui.ScrollBar}"
                                   Margin="4,0,0,0" Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
