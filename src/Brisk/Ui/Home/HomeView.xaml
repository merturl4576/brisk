<UserControl x:Class="Brisk.Ui.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Ui.Controls"
             xmlns:ui="clr-namespace:Brisk.Ui"
             Width="1100" Height="680">
    <!-- Drawn on the shell's 1100x680 design canvas; the nav column (x < 110)
         belongs to the shell. Positions come from the chosen mockup. -->
    <UserControl.Resources>
        <ui:ToneBrush x:Key="ToneBrush" />
        <ui:PresentToVisibility x:Key="Present" />
        <ui:EqualsToVisibility x:Key="Equals" />
        <Style x:Key="ColumnRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#407F9AA8" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,7" />
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- ===== Left column: this PC ===== -->
        <StackPanel Canvas.Left="120" Canvas.Top="150" Width="190">
            <TextBlock Style="{StaticResource Ui.Label}" FontWeight="Medium" Margin="0,0,0,6"
                       Text="{Binding L[gui.home.this-pc]}" />
            <Border Style="{StaticResource ColumnRow}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Ui.Value}" Text="{Binding Figures.Found}" />
                    <TextBlock Style="{StaticResource Ui.Value}" Text="{Binding L[gui.home.found]}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource ColumnRow}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Ui.Value}" Text="{Binding Figures.Startup}" />
                    <TextBlock Style="{StaticResource Ui.Value}" Text="{Binding L[gui.home.startup]}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource ColumnRow}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Ui.Value}" Text="{Binding Figures.Online}" />
                    <TextBlock Style="{StaticResource Ui.Value}" Text="{Binding L[gui.home.online]}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== Right column: slowing you now ===== -->
        <StackPanel Canvas.Left="884" Canvas.Top="150" Width="190">
            <TextBlock Style="{StaticResource Ui.Label}" FontWeight="Medium" Margin="0,0,0,6"
                       Text="{Binding L[gui.home.load]}" />
            <ItemsControl ItemsSource="{Binding Load}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ColumnRow}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Ui.Value}" Text="{Binding Value}" Margin="8,0,0,0" />
                                <TextBlock Style="{StaticResource Ui.Value}" Text="{Binding Name}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource ColumnRow}"
                    Visibility="{Binding LoadMeasuring, Converter={StaticResource Present}}">
                <TextBlock Style="{StaticResource Ui.MutedText}" Text="{Binding L[gui.load.measuring]}" />
            </Border>
            <Border Style="{StaticResource ColumnRow}"
                    Visibility="{Binding LoadEmpty, Converter={StaticResource Present}}">
                <TextBlock Style="{StaticResource Ui.Value}" Foreground="{StaticResource Ui.Green}"
                           Text="{Binding L[gui.home.load.none]}" />
            </Border>
            <Border Style="{StaticResource ColumnRow}"
                    Visibility="{Binding LoadError, Converter={StaticResource Present}}">
                <TextBlock Style="{StaticResource Ui.MutedText}" Text="{Binding LoadError}" />
            </Border>
        </StackPanel>

        <!-- ===== The hero gauge ===== -->
        <Grid Canvas.Left="350" Canvas.Top="52" Width="400" Height="400">
            <Ellipse Width="384" Height="384" Stroke="{StaticResource Ui.Accent}" StrokeThickness="2"
                     StrokeDashArray="75 528" StrokeDashCap="Round" Opacity="0.75"
                     c:Ambient.Motion="Spin" />
            <Ellipse Width="368" Height="368" Stroke="{StaticResource Ui.Accent}" StrokeThickness="1"
                     StrokeDashArray="40 1116" Opacity="0.5"
                     c:Ambient.Motion="SpinReverse" />
            <c:TickGauge Fraction="{Binding Figures.GaugeFraction}" Green="{Binding Figures.GaugeGreen}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Ui.Label}" FontSize="15" HorizontalAlignment="Center"
                           Text="{Binding Figures.HeroLabel}" />
                <c:HeroNumeral Bytes="{Binding Figures.HeroBytes}" Culture="{Binding Culture}"
                               FontFamily="{StaticResource Ui.DisplayFont}" Foreground="{StaticResource Ui.Text}"
                               HorizontalAlignment="Center" />
                <c:SegmentBar Fraction="{Binding Figures.GaugeFraction}" Green="{Binding Figures.GaugeGreen}"
                              HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===== Floor: the flowing line and the three satellites ===== -->
        <Viewbox Canvas.Left="0" Canvas.Top="436" Width="1100" Height="200" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1000" Height="200">
                <Path Data="M200 120 C 330 120, 380 160, 500 160 C 620 160, 670 120, 800 120"
                      Stroke="#8C5FD4E8" StrokeThickness="2" StrokeDashArray="3 5"
                      c:Ambient.Motion="Flow" />
            </Canvas>
        </Viewbox>
        <Grid x:Name="SpeedSatellite" Canvas.Left="100" Canvas.Bottom="110" Width="240">
            <c:SatelliteRing Value="{Binding Figures.Speed.Value}" Caption="{Binding Figures.Speed.Caption}"
                             Done="{Binding Figures.Speed.Done}" RingWidth="96" RingHeight="28" />
        </Grid>
        <Grid Canvas.Left="430" Canvas.Bottom="64" Width="240">
            <c:SatelliteRing Value="{Binding Figures.Space.Value}" Caption="{Binding Figures.Space.Caption}"
                             Done="{Binding Figures.Space.Done}" RingWidth="130" RingHeight="36" />
        </Grid>
        <Grid Canvas.Left="760" Canvas.Bottom="110" Width="240">
            <c:SatelliteRing Value="{Binding Figures.Privacy.Value}" Caption="{Binding Figures.Privacy.Caption}"
                             Done="{Binding Figures.Privacy.Done}" RingWidth="96" RingHeight="28" />
        </Grid>

        <!-- ===== Stateline (bottom-left) ===== -->
        <StackPanel x:Name="StatelinePanel" Canvas.Left="120" Canvas.Bottom="28" Width="340">
            <TextBlock Style="{StaticResource Ui.MutedText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                       Visibility="{Binding Figures.Previous, Converter={StaticResource Present}}">
                <Run Text="{Binding Figures.Previous, Mode=OneWay}" />
            </TextBlock>
            <Button Style="{StaticResource Ui.Link}" HorizontalAlignment="Left" Margin="0,0,0,6"
                    Content="{Binding L[gui.button.undo]}" Command="{Binding UndoPrevious}"
                    Visibility="{Binding Figures.ShowPreviousUndo, Converter={StaticResource Present}}" />
            <TextBlock FontSize="13" TextWrapping="Wrap" TextTrimming="None" FontFamily="{StaticResource Ui.Font}"
                       Text="{Binding Figures.Stateline}"
                       Foreground="{Binding Figures.StatelineTone, Converter={StaticResource ToneBrush}}">
                <TextBlock.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenFailed}" />
                </TextBlock.InputBindings>
            </TextBlock>
        </StackPanel>

        <!-- ===== The one button (bottom-right) ===== -->
        <StackPanel Canvas.Right="28" Canvas.Bottom="26" Orientation="Horizontal">
            <Button Style="{StaticResource Ui.Link}" VerticalAlignment="Center" Margin="0,0,18,0"
                    Content="{Binding L[gui.button.rescan]}" Command="{Binding Rescan}"
                    Visibility="{Binding Figures.ShowRescanLink, Converter={StaticResource Present}}" />
            <Button Style="{StaticResource Ui.Primary}" Content="{Binding Figures.Button}" Command="{Binding Primary}"
                    Visibility="{Binding Figures.ButtonAction, Converter={StaticResource Equals}, ConverterParameter=!Undo}" />
            <Button Style="{StaticResource Ui.Outline}" Content="{Binding Figures.Button}" Command="{Binding Primary}"
                    Visibility="{Binding Figures.ButtonAction, Converter={StaticResource Equals}, ConverterParameter=Undo}" />
        </StackPanel>
    </Canvas>
</UserControl>
