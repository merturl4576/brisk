<UserControl x:Class="Brisk.Ui.Pages.SpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Ui.Controls"
             xmlns:ui="clr-namespace:Brisk.Ui"
             Width="1100" Height="680">
    <!-- Yer aç on the shell's 1100x680 stage: the rows under their level on
         the left, the hero gauge in the middle, the C: block and the three
         level tiles on the right, one button under the gauge in the level's
         colour. No Geri al. The root canvas has no background, so clicks
         outside the page's parts fall through to the nav. -->
    <UserControl.Resources>
        <ui:PresentToVisibility x:Key="Present" />

        <!-- The chosen level's colour: the rings, the button and its glow.
             The code-behind cross-fades it when the level changes. -->
        <SolidColorBrush x:Key="LevelBrush" Color="#5FD4E8" />

        <!-- One file of the Downloads row: tick, name, size (the column is 210 wide). -->
        <DataTemplate x:Key="FileTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Ui.Check}" IsChecked="{Binding IsTicked}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.TextSoft}"
                           Text="{Binding Name}" ToolTip="{Binding Path}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource Ui.RowCost}" Text="{Binding Size}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- A Sileceklerim row: tap to skip it or take it back; above the
             level it is locked (dimmed, no tap). -->
        <DataTemplate x:Key="SpaceRow">
            <StackPanel x:Name="Root">
                <Border x:Name="Box" BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,1,0,0"
                        Background="Transparent" Cursor="Hand" ToolTip="{Binding WindowsName}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding TapCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <!-- A level up takes the row in: a short flash in the level's colour. -->
                        <Border x:Name="Flash" Background="{Binding LevelColor}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{Binding LevelColor}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="RowName" Style="{StaticResource Ui.RowTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding Note}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Note, Converter={StaticResource Present}}" />
                                <TextBlock Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.Amber}"
                                           Text="{Binding Warning}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Warning, Converter={StaticResource Present}}" />
                                <TextBlock Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.Red}"
                                           Text="{Binding ResultReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding ResultReason, Converter={StaticResource Present}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="Value" Style="{StaticResource Ui.Value}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Ui.TextSoft}" Text="{Binding Value}" />
                                <TextBlock Style="{StaticResource Ui.RowCost}" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"
                                           Foreground="{Binding LevelColor}" Opacity="0.75" Text="{Binding LevelName}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Outside the tap area: the Downloads row's files. -->
                <Button x:Name="Expand" Style="{StaticResource Ui.Link}" Content="▾" Command="{Binding ToggleExpand}"
                        HorizontalAlignment="Left" Margin="0,0,0,4"
                        Visibility="{Binding HasFiles, Converter={StaticResource Present}}" />
                <StackPanel Margin="0,0,0,8" Visibility="{Binding IsExpanded, Converter={StaticResource Present}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Style="{StaticResource Ui.Link}" Command="{Binding SelectAllFiles}"
                                Content="{Binding DataContext.L[gui.files.all], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Style="{StaticResource Ui.Link}" Command="{Binding SelectNoFiles}" Margin="16,0,0,0"
                                Content="{Binding DataContext.L[gui.files.none], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileTemplate}" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Revealed}" Value="False">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Off}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.38" />
                    <Setter TargetName="RowName" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <!-- After Off: a locked row is dimmer, not struck through, and takes no tap. -->
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.34" />
                    <Setter TargetName="RowName" Property="TextDecorations" Value="{x:Null}" />
                    <Setter TargetName="RowName" Property="Foreground" Value="{StaticResource Ui.Muted}" />
                    <Setter TargetName="Box" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="Expand" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lit}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="20">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.16" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Warn">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Bad">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Muted">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Muted}" />
                </DataTrigger>
                <!-- Last, so a row that went through is green. -->
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Green}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One level's rows under its header, in the level's colour. -->
        <DataTemplate x:Key="LevelGroup">
            <StackPanel x:Name="GroupRoot">
                <TextBlock x:Name="GroupHead" Style="{StaticResource Ui.Label}" FontSize="10.5" FontWeight="Bold"
                           Foreground="{Binding Color}" Text="{Binding Name}" Margin="0,12,0,3" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpaceRow}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="GroupHead" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRows}" Value="False">
                    <Setter TargetName="GroupRoot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The user's own files: muted, locked, no tap. -->
        <DataTemplate x:Key="MineRow">
            <Border BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,1,0,0" Padding="0,6" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ui.RowTitle}" Foreground="{StaticResource Ui.Muted}" Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Ui.Value}" Foreground="{StaticResource Ui.Muted}"
                               Text="{Binding Size}" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A level tile: its border in the level's colour at 40 %; chosen, the
             full colour, a 15 % fill and a glow. Name (and ⚠ on MAX) and
             tagline on the left, the size on the right. The MAX tile's fire
             comes in as the button's content, under the text. -->
        <Style x:Key="LevelTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Command" Value="{Binding Select}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Halo" CornerRadius="6" BorderThickness="1.5" BorderBrush="{Binding Color}"
                                    Visibility="Hidden">
                                <Border.Effect>
                                    <DropShadowEffect Color="{Binding Color}" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Fill" CornerRadius="6" Background="{Binding Color}" Opacity="0" />
                            <Border CornerRadius="6" ClipToBounds="True" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Bottom" />
                            </Border>
                            <!-- MAX: a dark scrim from the top over the fire, so the words stay readable. -->
                            <Rectangle x:Name="Scrim" RadiusX="6" RadiusY="6" IsHitTestVisible="False" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#B8050C12" />
                                        <GradientStop Offset="0.65" Color="#66050C12" />
                                        <GradientStop Offset="1" Color="#00050C12" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="Edge" CornerRadius="6" BorderThickness="1.5" BorderBrush="{Binding Color}"
                                    Opacity="0.4" />
                            <Grid Margin="12,9,12,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ui.TextBase}" FontSize="13" FontWeight="Bold"
                                               Foreground="{Binding Color}" Text="{Binding Name}" />
                                    <Viewbox x:Name="Warn" Width="13" Height="13" Margin="6,0,0,0" Visibility="Collapsed"
                                             VerticalAlignment="Center">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L15,14 L1,14 Z" Stroke="#FFB020" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                            <Path Data="M8,6.4 L8,9.8" Stroke="#FFB020" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Ellipse Canvas.Left="7.05" Canvas.Top="10.95" Width="1.9" Height="1.9" Fill="#FFB020" />
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                                <TextBlock x:Name="Tagline" Grid.Row="1" Style="{StaticResource Ui.MutedText}" FontSize="11.5"
                                           Margin="0,2,0,0" Text="{Binding Tagline}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource Ui.TextBase}" FontSize="22" FontWeight="Light"
                                               Foreground="#E8FBFF" Text="{Binding Number}" />
                                    <TextBlock Style="{StaticResource Ui.MutedText}" FontSize="12" Margin="3,0,0,3"
                                               VerticalAlignment="Bottom" Text="{Binding Unit}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMax}" Value="True">
                                <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Scrim" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Edge" Property="Opacity" Value="1" />
                                <Setter TargetName="Fill" Property="Opacity" Value="0.15" />
                                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tagline" Property="Foreground" Value="#D4EEF6" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The run is over: the tiles rest; the chosen one stays lit. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page's one button: a glowing pill under the gauge, in the level's colour. -->
        <Style x:Key="ActButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Pill" CornerRadius="22" MinWidth="240" Background="{StaticResource LevelBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{Binding Color, Source={StaticResource LevelBrush}}"
                                                      BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Shine" CornerRadius="22" Background="White" Opacity="0" />
                            <ContentPresenter Margin="32,12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter TargetName="Pill" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ButtonOk}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Ui.Green}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ButtonBusy}" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.4" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Width="1100" Height="680">
        <!-- Below the shell's mark and name (28..128, 20..52), clear of the nav. -->
        <TextBlock Canvas.Left="116" Canvas.Top="56" Style="{StaticResource Ui.H1}" Text="{Binding Title}" />

        <!-- ===== Left: Sileceklerim under their level, then the user's own files ===== -->
        <ScrollViewer Canvas.Left="116" Canvas.Top="100" Width="210" Height="520" Style="{StaticResource Ui.Scroll}">
            <StackPanel>
                <TextBlock Style="{StaticResource Ui.Label}" TextWrapping="Wrap" Margin="0,0,0,0">
                    <Run Text="{Binding ListTitle, Mode=OneWay}" /><Run Text=" · " /><Run
                         Text="{Binding Hint, Mode=OneWay}" Foreground="{StaticResource Ui.Muted}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource LevelGroup}" />

                <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowMine, Converter={StaticResource Present}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7" RadiusX="1.2" RadiusY="1.2"
                                           Stroke="{StaticResource Ui.Muted}" StrokeThickness="1.8" />
                                <Path Data="M5.5,7 L5.5,5 A2.5,2.5 0 0 1 10.5,5 L10.5,7" Stroke="{StaticResource Ui.Muted}"
                                      StrokeThickness="1.8" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Style="{StaticResource Ui.Label}" Foreground="{StaticResource Ui.Muted}"
                                   Text="{Binding MineTitle}" TextWrapping="Wrap" MaxWidth="192" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Mine}" ItemTemplate="{StaticResource MineRow}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: the C: block, then the level tiles ===== -->
        <StackPanel Canvas.Left="866" Canvas.Top="100" Width="210">
            <TextBlock Style="{StaticResource Ui.Label}" Text="{Binding DiskTitle}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Ui.RowTitle}" Foreground="{StaticResource Ui.TextSoft}" Text="{Binding FreeNowLabel}" />
                <TextBlock Style="{StaticResource Ui.Value}" HorizontalAlignment="Right" Text="{Binding FreeNow}" />
            </Grid>
            <Grid>
                <TextBlock Style="{StaticResource Ui.RowTitle}" Foreground="{StaticResource Ui.TextSoft}" Text="{Binding FreeAfterLabel}" />
                <TextBlock Style="{StaticResource Ui.Value}" HorizontalAlignment="Right" Foreground="{StaticResource Ui.Green}"
                           Text="{Binding FreeAfter}" />
            </Grid>

            <TextBlock Style="{StaticResource Ui.Label}" Text="{Binding LevelsTitle}" Margin="0,18,0,6" />
            <StackPanel x:Name="Tiles" KeyboardNavigation.DirectionalNavigation="None" PreviewKeyDown="OnTileKey">
                <Button Style="{StaticResource LevelTile}" DataContext="{Binding Levels[0]}" />
                <Button Style="{StaticResource LevelTile}" DataContext="{Binding Levels[1]}" />
                <Button x:Name="MaxTile" Style="{StaticResource LevelTile}" DataContext="{Binding Levels[2]}">
                    <!-- The fire: bottom-aligned, its source row under the tile's edge. -->
                    <Grid Height="0" VerticalAlignment="Bottom">
                        <Canvas>
                            <c:PixelFire x:Name="Fire" Canvas.Left="-1" Canvas.Bottom="-5" Width="210" Height="75">
                                <c:PixelFire.Style>
                                    <Style TargetType="c:PixelFire">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Hot" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MaxTile}" Value="True">
                                                <Setter Property="Hot" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=MaxTile}" Value="True">
                                                <Setter Property="Hot" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </c:PixelFire.Style>
                            </c:PixelFire>
                        </Canvas>
                    </Grid>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===== The hero gauge: what the chosen level frees, then what it freed ===== -->
        <Grid Canvas.Left="350" Canvas.Top="96" Width="400" Height="400">
            <!-- The rings turn 120° when a satellite comes to the front. -->
            <c:Turntable Angle="{Binding RingAngle}">
                <Ellipse Width="384" Height="384" Stroke="{StaticResource LevelBrush}" StrokeThickness="2"
                         StrokeDashArray="75 528" StrokeDashCap="Round" Opacity="0.75"
                         c:Ambient.Motion="Spin" />
                <Ellipse Width="368" Height="368" Stroke="{StaticResource LevelBrush}" StrokeThickness="1"
                         StrokeDashArray="40 1116" Opacity="0.5"
                         c:Ambient.Motion="SpinReverse" />
                <Path Data="M79.3,45.6 A196,196 0 0 1 227.3,5.9" Stroke="#E8FBFF" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="240" Height="240" Stroke="#9FD8E6" StrokeThickness="0.8" StrokeDashArray="2 6" Opacity="0.25" />
                <Ellipse Width="224" Height="224" Stroke="#9FD8E6" StrokeThickness="1" Opacity="0.35" />
                <Path Data="M129.3,129.3 L112.3,112.3 M270.7,129.3 L287.7,112.3 M129.3,270.7 L112.3,287.7 M270.7,270.7 L287.7,287.7"
                      Stroke="#9FD8E6" StrokeThickness="1" Opacity="0.45" />
            </c:Turntable>
            <Ellipse Width="210" Height="210" Fill="#8C05141C" />
            <c:TickGauge Fraction="{Binding Gauge.Fraction}" Green="{Binding Gauge.Green}" />

            <!-- The scan's sweep: only while the page looks. -->
            <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="Scanning">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Width="400" Height="400" Data="M200,4 A196,196 0 0 1 396,200"
                                                  Stroke="#E8FBFF" StrokeThickness="2" Opacity="0.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  c:Ambient.Motion="Busy" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock HorizontalAlignment="Center" Text="{Binding Gauge.Label}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ui.Label}">
                            <Setter Property="FontSize" Value="15" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Gauge.Green}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Ui.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Gauge.Bad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Ui.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <c:HeroNumeral Bytes="{Binding Gauge.Bytes}" Culture="{Binding Culture}" FontSize="80" UnitFontSize="26"
                               FontFamily="{StaticResource Ui.DisplayFont}" Foreground="{StaticResource Ui.Text}"
                               HorizontalAlignment="Center" />
                <TextBlock x:Name="Caption" Style="{StaticResource Ui.MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="190"
                           TextAlignment="Center" HorizontalAlignment="Center" Text="{Binding Gauge.Caption}"
                           Visibility="{Binding Gauge.Caption, Converter={StaticResource Present}}" />
                <c:SegmentBar Fraction="{Binding Gauge.Fraction}" Green="{Binding Gauge.Green}"
                              HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===== Bottom: the one button. No Geri al on Yer aç. ===== -->
        <Grid Canvas.Top="556" Width="1100">
            <Button Style="{StaticResource ActButton}" Command="{Binding RunGroup}" Content="{Binding Button}"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowButton, Converter={StaticResource Present}}" />
        </Grid>
    </Canvas>
</UserControl>
