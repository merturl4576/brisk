<UserControl x:Class="Brisk.Ui.Pages.GroupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Ui.Controls"
             xmlns:ui="clr-namespace:Brisk.Ui"
             Width="1100" Height="680">
    <!-- A detail page on the shell's 1100x680 stage: the list on the left, the
         hero gauge in the middle, Bırakıyorum / İstersen ekle on the right,
         one button under the gauge. The root canvas has no background, so
         clicks outside the page's parts fall through to the nav. -->
    <UserControl.Resources>
        <ui:ToneBrush x:Key="ToneBrush" />
        <ui:PresentToVisibility x:Key="Present" />
        <ui:EqualsToVisibility x:Key="Equals" />

        <!-- A Main / Also row: tap to skip it or take it back. -->
        <DataTemplate x:Key="ListRow">
            <StackPanel x:Name="Root">
                <Border x:Name="Box" BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,1,0,0" Padding="0,6"
                        Background="Transparent" Cursor="Hand" ToolTip="{Binding WindowsName}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding TapCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="RowName" Style="{StaticResource Ui.RowTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding Cost}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Cost, Converter={StaticResource Present}}" />
                            <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding RestartText}" Margin="0,2,0,0"
                                       Visibility="{Binding RestartText, Converter={StaticResource Present}}" />
                            <TextBlock Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.Red}"
                                       Text="{Binding ResultReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ResultReason, Converter={StaticResource Present}}" />
                        </StackPanel>
                        <TextBlock x:Name="Value" Grid.Column="1" Style="{StaticResource Ui.Value}"
                                   Foreground="{StaticResource Ui.TextSoft}" Text="{Binding Value}"
                                   Margin="10,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Revealed}" Value="False">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Off}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.38" />
                    <Setter TargetName="RowName" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Warn">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Bad">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Muted">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Muted}" />
                </DataTrigger>
                <!-- Last, so a row that went through is green. -->
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Ui.Green}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bırakıyorum: brisk leaves these alone; no tap. -->
        <DataTemplate x:Key="KeepRow">
            <Border BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,1,0,0" Padding="0,6"
                    Background="Transparent" ToolTip="{Binding WindowsName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ui.RowTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding Cost}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Cost, Converter={StaticResource Present}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Ui.Value}" Foreground="{StaticResource Ui.Muted}"
                               Text="{Binding Value}" Margin="10,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- İstersen ekle: tap to add the row to the run, or take it out again. -->
        <DataTemplate x:Key="ExtraRow">
            <Border BorderBrush="{StaticResource Ui.Line}" BorderThickness="0,1,0,0" Padding="0,6"
                    Background="Transparent" Cursor="Hand" ToolTip="{Binding WindowsName}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding TapCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ui.RowTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding Cost}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Cost, Converter={StaticResource Present}}" />
                        <TextBlock Style="{StaticResource Ui.RowCost}" Text="{Binding RestartText}" Margin="0,2,0,0"
                                   Visibility="{Binding RestartText, Converter={StaticResource Present}}" />
                        <TextBlock Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.Red}"
                                   Text="{Binding ResultReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ResultReason, Converter={StaticResource Present}}" />
                    </StackPanel>
                    <Border x:Name="Pill" Grid.Column="1" CornerRadius="9" Padding="8,1" BorderThickness="1"
                            BorderBrush="{StaticResource Ui.OutlineBorder}" Margin="10,1,0,0" VerticalAlignment="Top">
                        <TextBlock x:Name="PillText" Style="{StaticResource Ui.RowCost}" Foreground="{StaticResource Ui.TextSoft}"
                                   Text="{Binding Value}" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Added}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Ui.Accent}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="Bad">
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Ui.Red}" />
                </DataTrigger>
                <!-- Last, so an added row that went through is green. -->
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Ui.Green}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Ui.Green}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The page's one button: a glowing pill under the gauge. -->
        <Style x:Key="ActButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Ui.Font}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ui.ButtonText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="22" Padding="32,12" MinWidth="240"
                                Background="{StaticResource Ui.Accent}" Effect="{StaticResource Ui.Glow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#7FE0F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#7FE0F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter TargetName="Pill" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ButtonOk}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Ui.Green}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ButtonBusy}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#A9E3EF" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Width="1100" Height="680">
        <!-- Below the shell's mark and name (28..128, 20..52), clear of the nav. -->
        <TextBlock Canvas.Left="116" Canvas.Top="56" Style="{StaticResource Ui.H1}" Text="{Binding Title}" />

        <!-- ===== Left: what brisk does here, revealed as the scan reaches it ===== -->
        <ScrollViewer Canvas.Left="116" Canvas.Top="100" Width="210" Height="520" Style="{StaticResource Ui.Scroll}">
            <StackPanel>
                <TextBlock Style="{StaticResource Ui.Label}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="{Binding ListTitle, Mode=OneWay}" /><Run Text=" · " /><Run
                         Text="{Binding Hint, Mode=OneWay}" Foreground="{StaticResource Ui.Muted}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Main}" ItemTemplate="{StaticResource ListRow}" />
                <TextBlock Style="{StaticResource Ui.Label}" Text="{Binding AlsoTitle}" Margin="0,16,0,8"
                           Visibility="{Binding ShowAlso, Converter={StaticResource Present}}" />
                <ItemsControl ItemsSource="{Binding Also}" ItemTemplate="{StaticResource ListRow}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: Bırakıyorum and İstersen ekle, once the scan is over ===== -->
        <ScrollViewer Canvas.Left="866" Canvas.Top="100" Width="210" Height="520" Style="{StaticResource Ui.Scroll}"
                      Visibility="{Binding ShowRight, Converter={StaticResource Present}}">
            <StackPanel>
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding Keep.Count, Converter={StaticResource Equals}, ConverterParameter=!0}">
                    <TextBlock Style="{StaticResource Ui.Label}" Text="{Binding KeepTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Keep}" ItemTemplate="{StaticResource KeepRow}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Extra.Count, Converter={StaticResource Equals}, ConverterParameter=!0}">
                    <TextBlock Style="{StaticResource Ui.Label}" Text="{Binding ExtraTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Extra}" ItemTemplate="{StaticResource ExtraRow}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== The hero gauge: what this page found, then what it did ===== -->
        <Grid Canvas.Left="350" Canvas.Top="96" Width="400" Height="400">
            <!-- The rings turn 120° when a satellite comes to the front. -->
            <c:Turntable Angle="{Binding RingAngle}">
                <Ellipse Width="384" Height="384" Stroke="{StaticResource Ui.Accent}" StrokeThickness="2"
                         StrokeDashArray="75 528" StrokeDashCap="Round" Opacity="0.75"
                         c:Ambient.Motion="Spin" />
                <Ellipse Width="368" Height="368" Stroke="{StaticResource Ui.Accent}" StrokeThickness="1"
                         StrokeDashArray="40 1116" Opacity="0.5"
                         c:Ambient.Motion="SpinReverse" />
                <Path Data="M79.3,45.6 A196,196 0 0 1 227.3,5.9" Stroke="#E8FBFF" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="240" Height="240" Stroke="#9FD8E6" StrokeThickness="0.8" StrokeDashArray="2 6" Opacity="0.25" />
                <Ellipse Width="224" Height="224" Stroke="#9FD8E6" StrokeThickness="1" Opacity="0.35" />
                <Path Data="M129.3,129.3 L112.3,112.3 M270.7,129.3 L287.7,112.3 M129.3,270.7 L112.3,287.7 M270.7,270.7 L287.7,287.7"
                      Stroke="#9FD8E6" StrokeThickness="1" Opacity="0.45" />
            </c:Turntable>
            <Ellipse Width="210" Height="210" Fill="#8C05141C" />
            <c:TickGauge Fraction="{Binding Gauge.Fraction}" Green="{Binding Gauge.Green}" />

            <!-- The scan's sweep: only while the page looks. -->
            <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="Scanning">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Width="400" Height="400" Data="M200,4 A196,196 0 0 1 396,200"
                                                  Stroke="#E8FBFF" StrokeThickness="2" Opacity="0.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  c:Ambient.Motion="Busy" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock HorizontalAlignment="Center" Text="{Binding Gauge.Label}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ui.Label}">
                            <Setter Property="FontSize" Value="15" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Gauge.Green}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Ui.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Gauge.Bad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Ui.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Ui.TextBase}" Text="{Binding Gauge.Number}" FontSize="80"
                               FontFamily="{StaticResource Ui.DisplayFont}" Foreground="{StaticResource Ui.Text}" />
                    <TextBlock Style="{StaticResource Ui.TextBase}" Text="{Binding Gauge.Unit}" FontSize="26"
                               Foreground="{StaticResource Ui.TextSoft}" VerticalAlignment="Bottom" Margin="8,0,0,14"
                               Visibility="{Binding Gauge.Unit, Converter={StaticResource Present}}" />
                </StackPanel>
                <TextBlock x:Name="Caption" Style="{StaticResource Ui.MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="190"
                           TextAlignment="Center" HorizontalAlignment="Center" Text="{Binding Gauge.Caption}"
                           Visibility="{Binding Gauge.Caption, Converter={StaticResource Present}}" />
                <c:SegmentBar Fraction="{Binding Gauge.Fraction}" Green="{Binding Gauge.Green}"
                              HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===== Bottom: the one button, and Geri al under it ===== -->
        <Grid Canvas.Top="556" Width="1100">
            <StackPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource ActButton}" Command="{Binding RunGroup}" Content="{Binding Button}"
                        Visibility="{Binding ShowButton, Converter={StaticResource Present}}" />
                <Button Style="{StaticResource Ui.Link}" Content="{Binding UndoText}" Command="{Binding Undo}"
                        HorizontalAlignment="Center" Margin="0,10,0,0"
                        Visibility="{Binding ShowUndo, Converter={StaticResource Present}}" />
            </StackPanel>
        </Grid>
    </Canvas>
</UserControl>
